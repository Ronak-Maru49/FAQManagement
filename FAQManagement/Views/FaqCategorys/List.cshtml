@{
    ViewData["Title"] = "Category List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Grid layout for Cards */
    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .category-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #dee2e6;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        transition: transform 0.2s;
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

    /* Badi Image ka section */
    .card-img-top-container {
        width: 100%;
        height: 180px;
        background: #f8f9fa;
        border-bottom: 1px solid #eee;
    }

        .card-img-top-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .card-body-content {
        padding: 15px;
        text-align: center;
    }

    .category-title {
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 5px;
        color: #333;
    }

    .category-desc {
        font-size: 0.85rem;
        color: #6c757d;
        height: 40px;
        overflow: hidden;
    }

    /* Actions Buttons */
    .card-footer-actions {
        padding: 12px;
        background: #fcfcfc;
        border-top: 1px solid #eee;
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn-action {
        flex: 1;
        padding: 6px;
        border-radius: 5px;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .btn-add-main {
        background-color: #0D6EFD;
        color: white;
        padding: 8px 16px;
        border-radius: 5px;
        text-decoration: none;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="page-title">Category List</h5>
    <a class="btn-add-main" asp-action="Index" asp-controller="FaqCategorys">
        <i class="bi bi-plus-lg"></i> Add Category
    </a>
</div>

<div id="loadingSpinner" class="text-center p-5">
    <div class="spinner-border text-primary" role="status"></div>
</div>

<div id="noData" class="text-center p-5" style="display:none;">
    <p class="text-muted">No categories found.</p>
</div>

<div id="categoryGrid" class="category-grid" style="display:none;">
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-body text-center p-4">
                <i class="bi bi-exclamation-circle text-danger fs-1"></i>
                <h6 class="mt-3">Are you sure you want to delete?</h6>
                <div class="d-flex gap-2 mt-4">
                    <button type="button" class="btn btn-light flex-fill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger flex-fill" id="confirmBtn" onclick="confirmDelete()">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const API_BASE = '/api/FaqCategory';
    let deleteTargetId = null;

    document.addEventListener('DOMContentLoaded', () => loadCategories());

    async function loadCategories() {
        try {
            const res = await fetch(API_BASE);
            const data = await res.json();

            document.getElementById('loadingSpinner').style.display = 'none';

            if (!data || data.length === 0) {
                document.getElementById('noData').style.display = 'block';
                return;
            }

            renderGrid(data);
        } catch (err) {
            console.error(err);
        }
    }

    function renderGrid(categories) {
        const grid = document.getElementById('categoryGrid');
        grid.innerHTML = '';

        categories.forEach(cat => {
            // Edit link generate kar rahe hain purane controller ke liye
            // Maan lijiye aapka edit route FaqCategorys/Edit/5 hai
            const editUrl = `/FaqCategorys/Edit/${cat.id}`;

            const html = `
                <div class="category-card">
                    <div class="card-img-top-container">
                        ${cat.categoryImage
                            ? `<img src="${cat.categoryImage}" onerror="this.outerHTML='<div class=text-center p-5>No Image</div>'">`
                            : `<div class="p-5 text-center text-muted">No Image</div>`}
                    </div>
                    <div class="card-body-content">
                        <div class="category-title">${cat.categoryName || ''}</div>
                        <div class="category-desc">${cat.categoryDescription || ''}</div>
                    </div>
                    <div class="card-footer-actions">
                        <a href="${editUrl}" class="btn btn-primary btn-action">
                            <i class="bi bi-pencil-fill"></i> Edit
                        </a>
                        <button class="btn btn-danger btn-action" onclick="openDeleteModal(${cat.id})">
                            <i class="bi bi-trash-fill"></i> Delete
                        </button>
                    </div>
                </div>
            `;
            grid.insertAdjacentHTML('beforeend', html);
        });

        grid.style.display = 'grid';
    }

    function openDeleteModal(id) {
        deleteTargetId = id;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    async function confirmDelete() {
        if (!deleteTargetId) return;
        try {
            const res = await fetch(`${API_BASE}/${deleteTargetId}`, { method: 'DELETE' });
            if (res.ok) {
                location.reload();
            }
        } catch (err) {
            alert("Error deleting category");
        }
    }
</script>