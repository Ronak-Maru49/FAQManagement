@{
    ViewData["Title"] = "Category List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .category-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #dee2e6;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        transition: transform 0.2s;
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

    .card-img-top-container {
        width: 100%;
        height: 180px;
        background: #f8f9fa;
        border-bottom: 1px solid #eee;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

        .card-img-top-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }

        .card-img-top-container:hover img {
            transform: scale(1.05);
        }

    .card-body-content {
        padding: 15px;
        text-align: center;
    }

    .category-title {
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 5px;
        color: #333;
    }

    .category-desc {
        font-size: 0.85rem;
        color: #6c757d;
        height: 40px;
        overflow: hidden;
    }

    .card-footer-actions {
        padding: 12px;
        background: #fcfcfc;
        border-top: 1px solid #eee;
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn-action {
        flex: 1;
        padding: 6px;
        border-radius: 5px;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .btn-add-main {
        background-color: #0D6EFD;
        color: white;
        padding: 8px 16px;
        border-radius: 5px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    /* Subcategory Modal */
    #subCatModal .modal-body {
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    .filter-bar {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 15px;
        padding: 10px 15px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #e9ecef;
    }

    .sub-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 15px;
        margin-top: 10px;
    }

    .sub-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

    .sub-card-img {
        width: 100%;
        height: 110px;
        object-fit: cover;
        background: #f8f9fa;
    }

    .sub-card-body {
        padding: 10px;
        text-align: center;
    }

    .sub-card-title {
        font-weight: 600;
        font-size: 0.9rem;
        color: #333;
        margin-bottom: 3px;
    }

    .sub-card-desc {
        font-size: 0.78rem;
        color: #6c757d;
        height: 30px;
        overflow: hidden;
    }

    .sub-card-actions {
        display: flex;
        gap: 6px;
        padding: 8px;
        border-top: 1px solid #eee;
        background: #fcfcfc;
    }

        .sub-card-actions .btn {
            flex: 1;
            font-size: 0.78rem;
            padding: 4px;
        }

    .no-sub {
        text-align: center;
        padding: 30px;
        color: #adb5bd;
    }

    .sub-edit-form {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-top: 10px;
        border: 1px solid #dee2e6;
    }
</style>

<!-- Page Title -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="page-title">Category List</h5>
    <a class="btn-add-main" asp-action="Index" asp-controller="FaqCategorys">
        <i class="bi bi-plus-lg"></i> Add Category
    </a>
</div>

<!-- Loading -->
<div id="loadingSpinner" class="text-center p-5">
    <div class="spinner-border text-primary" role="status"></div>
</div>

<!-- No Data -->
<div id="noData" class="text-center p-5" style="display:none;">
    <i class="bi bi-inbox text-muted" style="font-size:2rem"></i>
    <p class="text-muted mt-2">No categories found.</p>
</div>

<!-- Category Grid -->
<div id="categoryGrid" class="category-grid" style="display:none;"></div>

<!-- ── Category Delete Modal ── -->
<div class="modal fade" id="deleteCatModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-body text-center p-4">
                <i class="bi bi-exclamation-circle text-danger fs-1"></i>
                <h6 class="mt-3">Delete this category?</h6>
                <p class="text-muted" style="font-size:0.82rem">This cannot be undone.</p>
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-light flex-fill" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-danger flex-fill" onclick="confirmDeleteCategory()">
                        <span id="catDelSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="appToast" class="toast align-items-center text-white border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="toastMsg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script>
    const CAT_API = '/api/FaqCategory';

    let deleteCatId = null;
    let deleteCatModalInstance = null;

    // ── Yahan apna Controller aur Action set karo ──
    const IMG_CLICK_CONTROLLER = 'FaqCategorys';   // <-- apna controller name
    const IMG_CLICK_ACTION     = 'SubCategoryList';        // <-- apna action name

    document.addEventListener('DOMContentLoaded', () => loadCategories());

    // ── Load Categories ──
    async function loadCategories() {
        try {
            const res = await fetch(CAT_API);
            const data = await res.json();
            document.getElementById('loadingSpinner').style.display = 'none';
            if (!data || data.length === 0) {
                document.getElementById('noData').style.display = 'block';
                return;
            }
            renderGrid(data);
        } catch (err) {
            console.error(err);
        }
    }

    function renderGrid(categories) {
        const grid = document.getElementById('categoryGrid');
        grid.innerHTML = '';
        categories.forEach(cat => {
            const imgHtml = cat.categoryImage
                ? `<img src="${cat.categoryImage}" alt="${cat.categoryName}" onerror="this.style.display='none'">`
                : `<div class="d-flex align-items-center justify-content-center h-100 text-muted"><i class="bi bi-image" style="font-size:2rem"></i></div>`;

            // Image click pe apne controller/action pe navigate karega with categoryId
            const imgClickUrl = `/${IMG_CLICK_CONTROLLER}/${IMG_CLICK_ACTION}/${cat.id}`;

            grid.insertAdjacentHTML('beforeend', `
                <div class="category-card" id="catcard-${cat.id}">
                    <div class="card-img-top-container" onclick="window.location.href='${imgClickUrl}'">
                        ${imgHtml}
                    </div>
                    <div class="card-body-content">
                        <div class="category-title">${cat.categoryName || ''}</div>
                        <div class="category-desc">${cat.categoryDescription || ''}</div>
                    </div>
                    <div class="card-footer-actions">
                        <a href="/FaqCategorys/Edit/${cat.id}" class="btn btn-primary btn-action">
                            <i class="bi bi-pencil-fill"></i> Edit
                        </a>
                        <button class="btn btn-danger btn-action" onclick="openDeleteCatModal(${cat.id})">
                            <i class="bi bi-trash-fill"></i> Delete
                        </button>
                    </div>
                </div>
            `);
        });
        grid.style.display = 'grid';
    }

    // ── Category Delete ──
    function openDeleteCatModal(id) {
        deleteCatId = id;
        deleteCatModalInstance = new bootstrap.Modal(document.getElementById('deleteCatModal'));
        deleteCatModalInstance.show();
    }

    async function confirmDeleteCategory() {
        if (!deleteCatId) return;
        document.getElementById('catDelSpinner').classList.remove('d-none');
        try {
            const res = await fetch(`${CAT_API}/${deleteCatId}`, { method: 'DELETE' });
            if (res.ok) {
                deleteCatModalInstance.hide();
                const card = document.getElementById(`catcard-${deleteCatId}`);
                if (card) {
                    card.style.opacity = '0';
                    card.style.transition = 'opacity 0.2s';
                    setTimeout(() => card.remove(), 200);
                }
                showToast('Category deleted!', 'success');
            } else {
                showToast('Delete failed.', 'danger');
            }
        } catch (e) {
            showToast('Network error.', 'danger');
        } finally {
            document.getElementById('catDelSpinner').classList.add('d-none');
            deleteCatId = null;
        }
    }

    // ── Toast ──
    function showToast(msg, type = 'success') {
        const toastEl = document.getElementById('appToast');
        document.getElementById('toastMsg').textContent = msg;
        toastEl.className = `toast align-items-center text-white border-0 bg-${type}`;
        new bootstrap.Toast(toastEl, { delay: 3000 }).show();
    }
</script>