@{
    ViewData["Title"] = "Category List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .category-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #dee2e6;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        transition: transform 0.2s;
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

    .card-img-top-container {
        width: 100%;
        height: 180px;
        background: #f8f9fa;
        border-bottom: 1px solid #eee;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

        .card-img-top-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }

        .card-img-top-container:hover img {
            transform: scale(1.05);
        }

    .img-overlay {
        position: absolute;
        inset: 0;
        background: rgba(13, 110, 253, 0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.25s;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 600;
        gap: 6px;
    }

    .card-img-top-container:hover .img-overlay {
        opacity: 1;
    }

    .card-body-content {
        padding: 15px;
        text-align: center;
    }

    .category-title {
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 5px;
        color: #333;
    }

    .category-desc {
        font-size: 0.85rem;
        color: #6c757d;
        height: 40px;
        overflow: hidden;
    }

    .card-footer-actions {
        padding: 12px;
        background: #fcfcfc;
        border-top: 1px solid #eee;
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn-action {
        flex: 1;
        padding: 6px;
        border-radius: 5px;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .btn-add-main {
        background-color: #0D6EFD;
        color: white;
        padding: 8px 16px;
        border-radius: 5px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    /* Subcategory Modal */
    #subCatModal .modal-body {
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    .filter-bar {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 15px;
        padding: 10px 15px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #e9ecef;
    }

    .sub-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 15px;
        margin-top: 10px;
    }

    .sub-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

    .sub-card-img {
        width: 100%;
        height: 110px;
        object-fit: cover;
        background: #f8f9fa;
    }

    .sub-card-body {
        padding: 10px;
        text-align: center;
    }

    .sub-card-title {
        font-weight: 600;
        font-size: 0.9rem;
        color: #333;
        margin-bottom: 3px;
    }

    .sub-card-desc {
        font-size: 0.78rem;
        color: #6c757d;
        height: 30px;
        overflow: hidden;
    }

    .sub-card-actions {
        display: flex;
        gap: 6px;
        padding: 8px;
        border-top: 1px solid #eee;
        background: #fcfcfc;
    }

        .sub-card-actions .btn {
            flex: 1;
            font-size: 0.78rem;
            padding: 4px;
        }

    .no-sub {
        text-align: center;
        padding: 30px;
        color: #adb5bd;
    }

    .sub-edit-form {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-top: 10px;
        border: 1px solid #dee2e6;
    }
</style>

<!-- Page Title -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="page-title">Category List</h5>
    <a class="btn-add-main" asp-action="Index" asp-controller="FaqCategorys">
        <i class="bi bi-plus-lg"></i> Add Category
    </a>
</div>

<!-- Loading -->
<div id="loadingSpinner" class="text-center p-5">
    <div class="spinner-border text-primary" role="status"></div>
</div>

<!-- No Data -->
<div id="noData" class="text-center p-5" style="display:none;">
    <i class="bi bi-inbox text-muted" style="font-size:2rem"></i>
    <p class="text-muted mt-2">No categories found.</p>
</div>

<!-- Category Grid -->
<div id="categoryGrid" class="category-grid" style="display:none;"></div>

<!-- ── Category Delete Modal ── -->
<div class="modal fade" id="deleteCatModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-body text-center p-4">
                <i class="bi bi-exclamation-circle text-danger fs-1"></i>
                <h6 class="mt-3">Delete this category?</h6>
                <p class="text-muted" style="font-size:0.82rem">This cannot be undone.</p>
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-light flex-fill" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-danger flex-fill" onclick="confirmDeleteCategory()">
                        <span id="catDelSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Subcategories Modal ── -->
<div class="modal fade" id="subCatModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" style="max-width:95vw;">
        <div class="modal-content" style="height:90vh;">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-0" id="subModalTitle">Subcategories</h5>
                    <small class="text-muted" id="subModalCatName"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <!-- Filter Bar -->
                <div class="filter-bar">
                    <label class="fw-semibold mb-0" style="font-size:0.88rem">
                        <i class="bi bi-funnel me-1"></i> Filter:
                    </label>
                    <input type="text"
                           id="subSearchInput"
                           class="form-control form-control-sm"
                           style="width:220px"
                           placeholder="Search subcategory..."
                           oninput="filterSubGrid()" />
                    <select id="subSeqSort"
                            class="form-select form-select-sm"
                            style="width:190px"
                            onchange="filterSubGrid()">
                        <option value="">Sort by Sequence</option>
                        <option value="asc">Sequence: Low to High</option>
                        <option value="desc">Sequence: High to Low</option>
                    </select>
                    <button class="btn btn-light btn-sm" onclick="resetSubFilter()">
                        <i class="bi bi-x-circle me-1"></i> Reset
                    </button>
                    <span id="subCountBadge" class="badge bg-primary rounded-pill ms-auto"></span>
                </div>

                <!-- Add SubCategory Button -->
                <div class="d-flex justify-content-end align-items-center mb-3">
                    <button class="btn btn-primary btn-sm" onclick="toggleAddSubForm()">
                        <i class="bi bi-plus-circle-fill me-1"></i> Add SubCategory
                    </button>
                </div>

                <!-- Add Form -->
                <div id="addSubForm" class="sub-edit-form" style="display:none">
                    <h6 class="mb-3 fw-semibold">New SubCategory</h6>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label form-label-sm">Name <span class="text-danger">*</span></label>
                            <input type="text" id="newSubName" class="form-control form-control-sm" placeholder="SubCategory Name" />
                            <div class="invalid-feedback">Required</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label form-label-sm">Sequence <span class="text-danger">*</span></label>
                            <input type="number" id="newSubSeq" class="form-control form-control-sm" placeholder="Sequence" min="1" />
                            <div class="invalid-feedback">Required</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label form-label-sm">Description <span class="text-danger">*</span></label>
                            <input type="text" id="newSubDesc" class="form-control form-control-sm" placeholder="Description" />
                            <div class="invalid-feedback">Required</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label form-label-sm">Image</label>
                            <input type="file" id="newSubImage" class="form-control form-control-sm" accept="image/*" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary btn-sm" onclick="saveNewSubCategory()">
                            <span id="addSubSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                            Save
                        </button>
                        <button class="btn btn-light btn-sm" onclick="toggleAddSubForm()">Cancel</button>
                    </div>
                </div>

                <!-- SubCategory Loading -->
                <div id="subLoadingSpinner" class="text-center p-4">
                    <div class="spinner-border spinner-border-sm text-primary"></div>
                </div>

                <!-- No SubCategory -->
                <div id="noSubData" class="no-sub" style="display:none">
                    <i class="bi bi-inbox" style="font-size:2rem"></i>
                    <p class="mt-2">No subcategories yet.</p>
                </div>

                <!-- SubCategory Grid -->
                <div id="subGrid" class="sub-grid" style="display:none"></div>

                <!-- Inline Edit Form -->
                <div id="editSubForm" class="sub-edit-form mt-3" style="display:none">
                    <h6 class="mb-3 fw-semibold">Edit SubCategory</h6>
                    <input type="hidden" id="editSubId" />
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label form-label-sm">Name <span class="text-danger">*</span></label>
                            <input type="text" id="editSubName" class="form-control form-control-sm" />
                            <div class="invalid-feedback">Required</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label form-label-sm">Sequence <span class="text-danger">*</span></label>
                            <input type="number" id="editSubSeq" class="form-control form-control-sm" min="1" />
                            <div class="invalid-feedback">Required</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label form-label-sm">Description <span class="text-danger">*</span></label>
                            <input type="text" id="editSubDesc" class="form-control form-control-sm" />
                            <div class="invalid-feedback">Required</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label form-label-sm">Image</label>
                            <input type="file" id="editSubImage" class="form-control form-control-sm" accept="image/*" />
                            <div id="editSubImagePreview" class="mt-1"></div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-success btn-sm" onclick="updateSubCategory()">
                            <span id="editSubSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                            Update
                        </button>
                        <button class="btn btn-light btn-sm" onclick="closeEditSubForm()">Cancel</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- ── SubCategory Delete Modal ── -->
<div class="modal fade" id="deleteSubModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-body text-center p-4">
                <i class="bi bi-exclamation-circle text-danger fs-1"></i>
                <h6 class="mt-3">Delete this subcategory?</h6>
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-light flex-fill" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-danger flex-fill" onclick="confirmDeleteSub()">
                        <span id="subDelSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="appToast" class="toast align-items-center text-white border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="toastMsg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script>
    const CAT_API = '/api/FaqCategory';
    const SUB_API = '/api/FaqSubCategory';

    let deleteCatId = null;
    let deleteSubId = null;
    let currentCategoryId = null;
    let subModalInstance = null;
    let deleteCatModalInstance = null;
    let deleteSubModalInstance = null;
    let allLoadedSubs = [];

    document.addEventListener('DOMContentLoaded', () => loadCategories());

    // ── Load Categories ──
    async function loadCategories() {
        try {
            const res = await fetch(CAT_API);
            const data = await res.json();
            document.getElementById('loadingSpinner').style.display = 'none';
            if (!data || data.length === 0) {
                document.getElementById('noData').style.display = 'block';
                return;
            }
            renderGrid(data);
        } catch (err) {
            console.error(err);
        }
    }

    function renderGrid(categories) {
        const grid = document.getElementById('categoryGrid');
        grid.innerHTML = '';
        categories.forEach(cat => {
            const imgHtml = cat.categoryImage
                ? `<img src="${cat.categoryImage}" alt="${cat.categoryName}" onerror="this.style.display='none'">`
                : `<div class="d-flex align-items-center justify-content-center h-100 text-muted"><i class="bi bi-image" style="font-size:2rem"></i></div>`;

            grid.insertAdjacentHTML('beforeend', `
                <div class="category-card" id="catcard-${cat.id}">
                    <div class="card-img-top-container" onclick="openSubCatModal(${cat.id}, '${escapeJs(cat.categoryName)}')">
                        ${imgHtml}
                        <div class="img-overlay">
                            <i class="bi bi-grid-3x3-gap"></i> View Subcategories
                        </div>
                    </div>
                    <div class="card-body-content">
                        <div class="category-title">${cat.categoryName || ''}</div>
                        <div class="category-desc">${cat.categoryDescription || ''}</div>
                    </div>
                    <div class="card-footer-actions">
                        <a href="/FaqCategorys/Edit/${cat.id}" class="btn btn-primary btn-action">
                            <i class="bi bi-pencil-fill"></i> Edit
                        </a>
                        <button class="btn btn-danger btn-action" onclick="openDeleteCatModal(${cat.id})">
                            <i class="bi bi-trash-fill"></i> Delete
                        </button>
                    </div>
                </div>
            `);
        });
        grid.style.display = 'grid';
    }

    // ── Category Delete ──
    function openDeleteCatModal(id) {
        deleteCatId = id;
        deleteCatModalInstance = new bootstrap.Modal(document.getElementById('deleteCatModal'));
        deleteCatModalInstance.show();
    }

    async function confirmDeleteCategory() {
        if (!deleteCatId) return;
        document.getElementById('catDelSpinner').classList.remove('d-none');
        try {
            const res = await fetch(`${CAT_API}/${deleteCatId}`, { method: 'DELETE' });
            if (res.ok) {
                deleteCatModalInstance.hide();
                const card = document.getElementById(`catcard-${deleteCatId}`);
                if (card) {
                    card.style.opacity = '0';
                    card.style.transition = 'opacity 0.2s';
                    setTimeout(() => card.remove(), 200);
                }
                showToast('Category deleted!', 'success');
            } else {
                showToast('Delete failed.', 'danger');
            }
        } catch (e) {
            showToast('Network error.', 'danger');
        } finally {
            document.getElementById('catDelSpinner').classList.add('d-none');
            deleteCatId = null;
        }
    }

    // ── Open SubCat Modal ──
    async function openSubCatModal(categoryId, categoryName) {
        currentCategoryId = categoryId;
        document.getElementById('subModalTitle').textContent = 'Subcategories';
        document.getElementById('subModalCatName').textContent = categoryName;
        document.getElementById('addSubForm').style.display = 'none';
        document.getElementById('editSubForm').style.display = 'none';
        document.getElementById('subGrid').style.display = 'none';
        document.getElementById('noSubData').style.display = 'none';
        document.getElementById('subLoadingSpinner').style.display = 'block';
        document.getElementById('subSearchInput').value = '';
        document.getElementById('subSeqSort').value = '';

        subModalInstance = new bootstrap.Modal(document.getElementById('subCatModal'));
        subModalInstance.show();

        await loadSubCategories(categoryId);
    }

    async function loadSubCategories(categoryId) {
        try {
            const res = await fetch(`${SUB_API}/ByCategory/${categoryId}`);
            const data = await res.json();
            document.getElementById('subLoadingSpinner').style.display = 'none';

            allLoadedSubs = data;

            updateBadge(data.length);

            if (!data || data.length === 0) {
                document.getElementById('noSubData').style.display = 'block';
                document.getElementById('subGrid').style.display = 'none';
                return;
            }
            renderSubGrid(data);
        } catch (e) {
            document.getElementById('subLoadingSpinner').style.display = 'none';
            showToast('Failed to load subcategories.', 'danger');
        }
    }

    function updateBadge(count) {
        document.getElementById('subCountBadge').textContent =
            count === 0 ? '0 subcategories' : `${count} subcategor${count > 1 ? 'ies' : 'y'}`;
    }

    function renderSubGrid(subs) {
        const grid = document.getElementById('subGrid');
        grid.innerHTML = '';
        subs.forEach(sub => {
            const imgHtml = sub.subCategoryImage
                ? `<img class="sub-card-img" src="${sub.subCategoryImage}" alt="${sub.subCategoryName}" onerror="this.style.display='none'">`
                : `<div class="sub-card-img d-flex align-items-center justify-content-center text-muted bg-light"><i class="bi bi-image" style="font-size:1.5rem"></i></div>`;

            grid.insertAdjacentHTML('beforeend', `
                <div class="sub-card" id="subcard-${sub.id}">
                    ${imgHtml}
                    <div class="sub-card-body">
                        <div class="sub-card-title">${sub.subCategoryName || ''}</div>
                        <div class="sub-card-desc">${sub.subCategoryDescription || ''}</div>
                    </div>
                    <div class="sub-card-actions">
                        <button class="btn btn-primary btn-sm"
                            onclick="openEditSubForm(${sub.id}, '${escapeJs(sub.subCategoryName)}', '${escapeJs(sub.subCategoryDescription)}', ${sub.subCategorySequence}, '${sub.subCategoryImage || ''}')">
                            <i class="bi bi-pencil-fill"></i> Edit
                        </button>
                        <button class="btn btn-danger btn-sm" onclick="openDeleteSubModal(${sub.id})">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </div>
                </div>
            `);
        });
        grid.style.display = 'grid';
    }

    // ── Filter & Sort ──
    function filterSubGrid() {
        const search = document.getElementById('subSearchInput').value.trim().toLowerCase();
        const sort = document.getElementById('subSeqSort').value;

        let filtered = [...allLoadedSubs];

        if (search) {
            filtered = filtered.filter(s =>
                (s.subCategoryName || '').toLowerCase().includes(search) ||
                (s.subCategoryDescription || '').toLowerCase().includes(search)
            );
        }

        if (sort === 'asc') filtered.sort((a, b) => a.subCategorySequence - b.subCategorySequence);
        if (sort === 'desc') filtered.sort((a, b) => b.subCategorySequence - a.subCategorySequence);

        updateBadge(filtered.length);

        if (filtered.length === 0) {
            document.getElementById('subGrid').style.display = 'none';
            document.getElementById('noSubData').style.display = 'block';
        } else {
            document.getElementById('noSubData').style.display = 'none';
            renderSubGrid(filtered);
        }
    }

    function resetSubFilter() {
        document.getElementById('subSearchInput').value = '';
        document.getElementById('subSeqSort').value = '';
        filterSubGrid();
    }

    function escapeJs(str) {
        if (!str) return '';
        return str.replace(/'/g, "\\'").replace(/"/g, '\\"');
    }

    // ── Add SubCategory ──
    function toggleAddSubForm() {
        const form = document.getElementById('addSubForm');
        const visible = form.style.display !== 'none';
        form.style.display = visible ? 'none' : 'block';
        if (!visible) {
            document.getElementById('newSubName').value = '';
            document.getElementById('newSubDesc').value = '';
            document.getElementById('newSubSeq').value = '';
            document.getElementById('newSubImage').value = '';
            ['newSubName', 'newSubDesc', 'newSubSeq'].forEach(id =>
                document.getElementById(id).classList.remove('is-invalid'));
        }
    }

    async function saveNewSubCategory() {
        const name = document.getElementById('newSubName').value.trim();
        const desc = document.getElementById('newSubDesc').value.trim();
        const seq = document.getElementById('newSubSeq').value.trim();
        let valid = true;

        if (!name) { document.getElementById('newSubName').classList.add('is-invalid'); valid = false; }
        else document.getElementById('newSubName').classList.remove('is-invalid');

        if (!desc) { document.getElementById('newSubDesc').classList.add('is-invalid'); valid = false; }
        else document.getElementById('newSubDesc').classList.remove('is-invalid');

        if (!seq || isNaN(seq) || parseInt(seq) < 1) { document.getElementById('newSubSeq').classList.add('is-invalid'); valid = false; }
        else document.getElementById('newSubSeq').classList.remove('is-invalid');

        if (!valid) return;

        let imageBase64 = null;
        const file = document.getElementById('newSubImage').files[0];
        if (file) {
            imageBase64 = await new Promise(r => {
                const rd = new FileReader();
                rd.onload = e => r(e.target.result);
                rd.readAsDataURL(file);
            });
        }

        document.getElementById('addSubSpinner').classList.remove('d-none');

        try {
            const res = await fetch(SUB_API, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    categoryId: currentCategoryId,
                    subCategoryName: name,
                    subCategoryDescription: desc,
                    subCategorySequence: parseInt(seq),
                    subCategoryImage: imageBase64
                })
            });
            if (res.ok) {
                showToast('SubCategory added!', 'success');
                toggleAddSubForm();
                document.getElementById('subGrid').style.display = 'none';
                document.getElementById('noSubData').style.display = 'none';
                document.getElementById('subLoadingSpinner').style.display = 'block';
                await loadSubCategories(currentCategoryId);
            } else {
                showToast('Failed to add.', 'danger');
            }
        } catch (e) {
            showToast('Network error.', 'danger');
        } finally {
            document.getElementById('addSubSpinner').classList.add('d-none');
        }
    }

    // ── Edit SubCategory ──
    function openEditSubForm(id, name, desc, seq, img) {
        document.getElementById('editSubId').value = id;
        document.getElementById('editSubName').value = name;
        document.getElementById('editSubDesc').value = desc;
        document.getElementById('editSubSeq').value = seq;
        document.getElementById('editSubImage').value = '';
        document.getElementById('editSubImagePreview').innerHTML =
            img ? `<img src="${img}" style="height:50px;border-radius:4px;margin-top:4px;">` : '';
        document.getElementById('editSubForm').style.display = 'block';
        document.getElementById('editSubForm').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function closeEditSubForm() {
        document.getElementById('editSubForm').style.display = 'none';
    }

    async function updateSubCategory() {
        const id = document.getElementById('editSubId').value;
        const name = document.getElementById('editSubName').value.trim();
        const desc = document.getElementById('editSubDesc').value.trim();
        const seq = document.getElementById('editSubSeq').value.trim();
        let valid = true;

        if (!name) { document.getElementById('editSubName').classList.add('is-invalid'); valid = false; }
        else document.getElementById('editSubName').classList.remove('is-invalid');

        if (!desc) { document.getElementById('editSubDesc').classList.add('is-invalid'); valid = false; }
        else document.getElementById('editSubDesc').classList.remove('is-invalid');

        if (!seq || isNaN(seq) || parseInt(seq) < 1) { document.getElementById('editSubSeq').classList.add('is-invalid'); valid = false; }
        else document.getElementById('editSubSeq').classList.remove('is-invalid');

        if (!valid) return;

        let imageBase64 = null;
        const file = document.getElementById('editSubImage').files[0];
        if (file) {
            imageBase64 = await new Promise(r => {
                const rd = new FileReader();
                rd.onload = e => r(e.target.result);
                rd.readAsDataURL(file);
            });
        }

        document.getElementById('editSubSpinner').classList.remove('d-none');

        try {
            const res = await fetch(`${SUB_API}/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    id: parseInt(id),
                    categoryId: currentCategoryId,
                    subCategoryName: name,
                    subCategoryDescription: desc,
                    subCategorySequence: parseInt(seq),
                    subCategoryImage: imageBase64
                })
            });
            if (res.ok) {
                showToast('SubCategory updated!', 'success');
                closeEditSubForm();
                document.getElementById('subGrid').style.display = 'none';
                document.getElementById('subLoadingSpinner').style.display = 'block';
                await loadSubCategories(currentCategoryId);
            } else {
                showToast('Update failed.', 'danger');
            }
        } catch (e) {
            showToast('Network error.', 'danger');
        } finally {
            document.getElementById('editSubSpinner').classList.add('d-none');
        }
    }

    // ── Delete SubCategory ──
    function openDeleteSubModal(id) {
        deleteSubId = id;
        deleteSubModalInstance = new bootstrap.Modal(document.getElementById('deleteSubModal'));
        deleteSubModalInstance.show();
    }

    async function confirmDeleteSub() {
        if (!deleteSubId) return;
        document.getElementById('subDelSpinner').classList.remove('d-none');
        try {
            const res = await fetch(`${SUB_API}/${deleteSubId}`, { method: 'DELETE' });
            if (res.ok) {
                deleteSubModalInstance.hide();
                const card = document.getElementById(`subcard-${deleteSubId}`);
                if (card) {
                    card.style.opacity = '0';
                    card.style.transition = 'opacity 0.2s';
                    setTimeout(() => card.remove(), 200);
                }
                allLoadedSubs = allLoadedSubs.filter(s => s.id !== deleteSubId);
                updateBadge(allLoadedSubs.length);
                showToast('SubCategory deleted!', 'success');
            } else {
                showToast('Delete failed.', 'danger');
            }
        } catch (e) {
            showToast('Network error.', 'danger');
        } finally {
            document.getElementById('subDelSpinner').classList.add('d-none');
            deleteSubId = null;
        }
    }

    // ── Toast ──
    function showToast(msg, type = 'success') {
        const toastEl = document.getElementById('appToast');
        document.getElementById('toastMsg').textContent = msg;
        toastEl.className = `toast align-items-center text-white border-0 bg-${type}`;
        new bootstrap.Toast(toastEl, { delay: 3000 }).show();
    }
</script>