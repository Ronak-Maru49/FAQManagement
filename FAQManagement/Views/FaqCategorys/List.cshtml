@{
    ViewData["Title"] = "Category List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .breadcrumb-area {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .page-title {
        font-size: 1.4rem;
        font-weight: 600;
        color: #333;
    }

    .breadcrumb {
        background: none;
        padding: 0;
        margin: 0;
        font-size: 0.85rem;
    }

    .breadcrumb-item a {
        color: #6c757d;
        text-decoration: none;
    }

    .breadcrumb-item.active {
        color: #333;
    }

    .card {
        border: none;
        border-radius: 8px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.08);
    }

    .card-body {
        padding: 24px;
    }

    .table thead th {
        background-color: #f8f9fa;
        font-weight: 600;
        font-size: 0.875rem;
        color: #444;
        border-bottom: 2px solid #dee2e6;
        white-space: nowrap;
    }

    .table tbody td {
        vertical-align: middle;
        font-size: 0.875rem;
        color: #555;
    }

    .table tbody tr:hover {
        background-color: #fafafa;
    }

    .category-img {
        width: 70px;
        height: 55px;
        object-fit: cover;
        border-radius: 4px;
        border: 1px solid #dee2e6;
        background: #f0f0f0;
    }

    .category-img-placeholder {
        width: 70px;
        height: 55px;
        background: #f0f0f0;
        border-radius: 4px;
        border: 1px solid #dee2e6;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #aaa;
        font-size: 0.7rem;
        margin: auto;
    }

    .btn-edit {
        background-color: #0D6EFD;
        border: none;
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s;
        padding: 0;
    }

        .btn-edit:hover {
            background-color: #0D6EFD;
        }

    .btn-delete {
        background-color: #e05c3a;
        border: none;
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s;
        padding: 0;
    }

        .btn-delete:hover {
            background-color: #c0392b;
        }

    .btn-add {
        background-color: #0D6EFD;
        border: none;
        color: white;
        padding: 7px 18px;
        border-radius: 5px;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-add:hover {
            background-color: #0D6EFD;
        }

    .modal-header {
        background-color: #0D6EFD;
        color: white;
        border-radius: 8px 8px 0 0;
    }

        .modal-header .btn-close {
            filter: invert(1);
        }

    #loadingSpinner {
        display: none;
        text-align: center;
        padding: 40px 0;
    }

    #noData {
        display: none;
        text-align: center;
        padding: 40px 0;
        color: #888;
    }
</style>

<!-- Breadcrumb -->
<div class="breadcrumb-area">
    <h5 class="page-title">Category List</h5>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#"><i class="bi bi-house-door"></i></a></li>
            <li class="breadcrumb-item"><a href="#">Category</a></li>
            <li class="breadcrumb-item active">Category List</li>
        </ol>
    </nav>
</div>

<!-- Main Card -->
<div class="card">
    <div class="card-body">

        <!-- Top bar: Add Button -->
        <div class="d-flex justify-content-end mb-3">
            <a class="btn-add text-decoration-none" asp-action="Index" asp-controller="FaqCategorys">
                + Add Category
            </a>
        </div>

        <!-- Loading Spinner -->
        <div id="loadingSpinner">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading categories...</p>
        </div>

        <!-- No Data Message -->
        <div id="noData">
            <i class="bi bi-inbox fs-2 text-muted"></i>
            <p class="mt-2">No categories found.</p>
        </div>

        <!-- DataTable -->
        <div class="table-responsive">
            <table id="categoryTable" class="table table-bordered table-hover align-middle w-100" style="display:none;">
                <thead>
                    <tr>
                        <th style="width:50px;">No</th>
                        <th>Category Name</th>
                        <th>Category Description</th>
                        <th style="width:110px; text-align:center;">Category Image</th>
                        <th style="width:100px; text-align:center;">Action</th>
                    </tr>
                </thead>
                <tbody id="categoryTableBody"></tbody>
            </table>
        </div>
    </div>
</div>
<!-- ── ADD / EDIT MODAL ─────────────────────────────────────────────── -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="categoryModalLabel">Add Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="categoryId" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
                    <input type="text" id="categoryName" class="form-control" placeholder="Enter category name" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Category Description</label>
                    <textarea id="categoryDescription" class="form-control" rows="3" placeholder="Enter description"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Category Image URL</label>
                    <input type="text" id="categoryImage" class="form-control" placeholder="https://example.com/image.png" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Category Sequence</label>
                        <input type="number" id="categorySequence" class="form-control" placeholder="0" min="0" value="0" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Parent Sequence</label>
                        <input type="number" id="parentSequence" class="form-control" placeholder="0" min="0" value="0" />
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="isParent" />
                    <label class="form-check-label fw-semibold" for="isParent">Is Parent Category</label>
                </div>

                <div id="modalError" class="alert alert-danger d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="saveCategoryBtn" onclick="saveCategory()">
                    <span id="saveBtnText">Save</span>
                    <span id="saveBtnSpinner" class="spinner-border spinner-border-sm d-none ms-1" role="status"></span>
                </button>
            </div>
        </div>
    </div>
</div>


<!-- ── DELETE CONFIRM MODAL ─────────────────────────────────────────── -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white" style="border-radius:8px 8px 0 0;">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" style="filter:invert(1);"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-3 mb-2 d-block"></i>
                <p class="mb-0">Are you sure you want to delete this category?</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm" id="confirmDeleteBtn" onclick="confirmDelete()">
                    <span id="deleteBtnText">Delete</span>
                    <span id="deleteBtnSpinner" class="spinner-border spinner-border-sm d-none ms-1" role="status"></span>
                </button>
            </div>
        </div>
    </div>
</div>


<!-- ── TOAST NOTIFICATION ───────────────────────────────────────────── -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999;">
    <div id="toastMsg" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive">
        <div class="d-flex">
            <div class="toast-body" id="toastText"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>


<!-- ── CSS & JS DEPENDENCIES ────────────────────────────────────────── -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    const API_BASE = '/api/FaqCategory';
    let dataTable = null;
    let deleteTargetId = null;

    // ── INIT ──────────────────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', () => loadCategories());

    // ── LOAD ALL CATEGORIES ───────────────────────────────────────────────
    async function loadCategories() {
        document.getElementById('loadingSpinner').style.display = 'block';
        document.getElementById('noData').style.display = 'none';
        document.getElementById('categoryTable').style.display = 'none';

        if (dataTable) { dataTable.destroy(); dataTable = null; }
        document.getElementById('categoryTableBody').innerHTML = '';

        try {
            const res = await fetch(API_BASE);
            if (!res.ok) throw new Error(`Server error: ${res.status}`);
            const data = await res.json();

            document.getElementById('loadingSpinner').style.display = 'none';

            if (!data || data.length === 0) {
                document.getElementById('noData').style.display = 'block';
                return;
            }

            renderTable(data);
        } catch (err) {
            document.getElementById('loadingSpinner').style.display = 'none';
            showToast('Error loading categories: ' + err.message, 'danger');
        }
    }

    // ── RENDER TABLE ROWS ─────────────────────────────────────────────────
    function renderTable(categories) {
        const tbody = document.getElementById('categoryTableBody');
        tbody.innerHTML = '';

        categories.forEach((cat, index) => {
            const imgHtml = cat.categoryImage
                ? `<img src="${escapeHtml(cat.categoryImage)}" class="category-img" alt="img"
                        onerror="this.outerHTML='<div class=&quot;category-img-placeholder&quot;>No Image</div>'" />`
                : `<div class="category-img-placeholder">No Image</div>`;

            tbody.insertAdjacentHTML('beforeend', `
                <tr>
                    <td class="text-center">${index + 1}</td>
                    <td>${escapeHtml(cat.categoryName || '')}</td>
                    <td>${escapeHtml(cat.categoryDescription || '')}</td>
                    <td class="text-center">${imgHtml}</td>
                    <td class="text-center">
                        <button class="btn-edit me-1" title="Edit" onclick="openEditModal(${cat.id})">
                            <i class="bi bi-pencil-fill" style="font-size:0.75rem;"></i>
                        </button>
                        <button class="btn-delete" title="Delete" onclick="openDeleteModal(${cat.id})">
                            <i class="bi bi-trash-fill" style="font-size:0.75rem;"></i>
                        </button>
                    </td>
                </tr>`);
        });

        document.getElementById('categoryTable').style.display = '';

        dataTable = $('#categoryTable').DataTable({
            pageLength: 10,
            lengthMenu: [5, 10, 25, 50],
            order: [],
            columnDefs: [{ orderable: false, targets: [3, 4] }],
            language: {
                search: 'Search:',
                lengthMenu: 'Show _MENU_ entries'
            }
        });
    }

    // ── OPEN ADD MODAL ────────────────────────────────────────────────────
    function openAddModal() {
        document.getElementById('categoryModalLabel').textContent = 'Add Category';
        document.getElementById('categoryId').value = '';
        document.getElementById('categoryName').value = '';
        document.getElementById('categoryDescription').value = '';
        document.getElementById('categoryImage').value = '';
        document.getElementById('categorySequence').value = '0';
        document.getElementById('parentSequence').value = '0';
        document.getElementById('isParent').checked = false;
        document.getElementById('modalError').classList.add('d-none');
        document.getElementById('saveBtnText').textContent = 'Save';
    }

    // ── OPEN EDIT MODAL ───────────────────────────────────────────────────
    async function openEditModal(id) {
        document.getElementById('categoryModalLabel').textContent = 'Edit Category';
        document.getElementById('modalError').classList.add('d-none');
        document.getElementById('saveBtnText').textContent = 'Update';

        try {
            const res = await fetch(`${API_BASE}/${id}`);
            if (!res.ok) throw new Error('Category not found');
            const cat = await res.json();

            document.getElementById('categoryId').value = cat.id;
            document.getElementById('categoryName').value = cat.categoryName || '';
            document.getElementById('categoryDescription').value = cat.categoryDescription || '';
            document.getElementById('categoryImage').value = cat.categoryImage || '';
            document.getElementById('categorySequence').value = cat.categorySequence ?? 0;
            document.getElementById('parentSequence').value = cat.parentSequence ?? 0;
            document.getElementById('isParent').checked = !!cat.isParent;

            new bootstrap.Modal(document.getElementById('categoryModal')).show();
        } catch (err) {
            showToast('Error loading category: ' + err.message, 'danger');
        }
    }

    // ── SAVE (CREATE or UPDATE) ───────────────────────────────────────────
    async function saveCategory() {
        const id = document.getElementById('categoryId').value;
        const name = document.getElementById('categoryName').value.trim();

        if (!name) {
            showModalError('Category Name is required.');
            return;
        }

        document.getElementById('modalError').classList.add('d-none');
        setLoading('saveCategoryBtn', 'saveBtnSpinner', true);

        const payload = {
            categoryName: name,
            categoryDescription: document.getElementById('categoryDescription').value.trim(),
            categoryImage: document.getElementById('categoryImage').value.trim(),
            categorySequence: parseInt(document.getElementById('categorySequence').value) || 0,
            parentSequence: parseInt(document.getElementById('parentSequence').value) || 0,
            isParent: document.getElementById('isParent').checked
        };

        try {
            let res;
            if (id) {
                res = await fetch(`${API_BASE}/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: parseInt(id), ...payload })
                });
            } else {
                res = await fetch(API_BASE, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
            }

            if (!res.ok) {
                const err = await res.json().catch(() => ({}));
                throw new Error(err.message || `Server error: ${res.status}`);
            }

            bootstrap.Modal.getInstance(document.getElementById('categoryModal')).hide();
            showToast(id ? 'Category updated successfully!' : 'Category added successfully!', 'success');
            await loadCategories();
        } catch (err) {
            showModalError('Error: ' + err.message);
        } finally {
            setLoading('saveCategoryBtn', 'saveBtnSpinner', false);
        }
    }

    // ── DELETE ────────────────────────────────────────────────────────────
    function openDeleteModal(id) {
        deleteTargetId = id;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    async function confirmDelete() {
        if (!deleteTargetId) return;

        setLoading('confirmDeleteBtn', 'deleteBtnSpinner', true);

        try {
            const res = await fetch(`${API_BASE}/${deleteTargetId}`, { method: 'DELETE' });
            if (!res.ok) throw new Error(`Server error: ${res.status}`);

            bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
            showToast('Category deleted successfully!', 'success');
            deleteTargetId = null;
            await loadCategories();
        } catch (err) {
            showToast('Error: ' + err.message, 'danger');
        } finally {
            setLoading('confirmDeleteBtn', 'deleteBtnSpinner', false);
        }
    }

    // ── HELPERS ───────────────────────────────────────────────────────────
    function showToast(message, type = 'success') {
        const toast = document.getElementById('toastMsg');
        toast.className = `toast align-items-center text-white border-0 bg-${type}`;
        document.getElementById('toastText').textContent = message;
        new bootstrap.Toast(toast, { delay: 3000 }).show();
    }

    function showModalError(msg) {
        const el = document.getElementById('modalError');
        el.textContent = msg;
        el.classList.remove('d-none');
    }

    function setLoading(btnId, spinnerId, loading) {
        document.getElementById(btnId).disabled = loading;
        const spinner = document.getElementById(spinnerId);
        loading ? spinner.classList.remove('d-none') : spinner.classList.add('d-none');
    }

    function escapeHtml(str) {
        const div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
    }
</script>
