<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add SubCategory</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/FaqCategory.css" rel="stylesheet" />
</head>
<body class="bg-light">

    <div class="page-header bg-white border-bottom p-3">
        <h5><i class="bi bi-diagram-3 me-2"></i>Add SubCategory</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/FaqCategorys/List"><i class="bi bi-house"></i></a></li>
                <li class="breadcrumb-item active">Add SubCategory</li>
            </ol>
        </nav>
    </div>

    <div class="container-fluid px-4 py-4">
        <div class="card p-4 border-0 shadow-sm">

            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold text-dark">SubCategories</span>
                    <span class="badge bg-primary rounded-pill" id="countBadge">1 subcategory</span>
                </div>
            </div>

            <div id="subCategoriesContainer" class="d-flex flex-column gap-3"></div>

            <div class="mt-3">
                <button class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1 px-2 py-1" onclick="addSubCategoryBlock()">
                    <i class="bi bi-plus-circle-fill"></i>
                    Add Another SubCategory
                </button>
            </div>

            <hr class="mt-4" />

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-primary px-4" id="saveBtn" onclick="saveAll()">
                    <span class="spinner-border spinner-border-sm me-1 d-none" id="saveSpinner"></span>
                    Save All
                </button>
                <button type="button" class="btn btn-light px-4" onclick="resetAll()">Reset All</button>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="appToast" class="toast align-items-center text-white border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body fw-semibold" id="toastMsg"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const API_BASE = '/api/FaqSubCategory';
        let blockCounter = 0;

        const getUrlId = () => {
            const parts = window.location.pathname.split('/');
            return parseInt(parts[parts.length - 1]) || 0;
        };
        const TARGET_CATEGORY_ID = getUrlId();

        function createBlockHTML(id) {
            return `
            <div class="card border category-block" id="block-${id}">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-secondary">#<span id="num-${id}">1</span> SubCategory Details</span>
                    <button class="btn btn-sm btn-outline-danger" onclick="removeBlock(${id})" id="removebtn-${id}" style="display:none">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
                <div class="card-body p-4">
                    <input type="hidden" id="categoryId-${id}" value="${TARGET_CATEGORY_ID}" />

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold small">SubCategory Name <span class="text-danger">*</span></label>
                            <input type="text" id="subCategoryName-${id}" class="form-control" placeholder="Enter name" oninput="this.classList.remove('is-invalid')" />
                            <div class="invalid-feedback">SubCategory Name is required.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Sequence <span class="text-danger">*</span></label>
                            <input type="number" id="subCategorySequence-${id}" class="form-control" value="${document.querySelectorAll('.category-block').length + 1}" oninput="this.classList.remove('is-invalid')" />
                            <div class="invalid-feedback">Sequence is required.</div>
                        </div>
                    </div>
                </div>
            </div>`;
        }

        function addSubCategoryBlock() {
            blockCounter++;
            const container = document.getElementById('subCategoriesContainer');
            const div = document.createElement('div');
            div.innerHTML = createBlockHTML(blockCounter);
            container.appendChild(div.firstElementChild);
            updateBlockNumbers();
        }

        function removeBlock(id) {
            document.getElementById(`block-${id}`).remove();
            updateBlockNumbers();
        }

        function updateBlockNumbers() {
            const blocks = document.querySelectorAll('.category-block');
            blocks.forEach((block, i) => {
                const id = block.id.replace('block-', '');
                document.getElementById(`num-${id}`).textContent = i + 1;
                document.getElementById(`removebtn-${id}`).style.display = blocks.length > 1 ? '' : 'none';
            });
            document.getElementById('countBadge').textContent = `${blocks.length} subcategory${blocks.length === 1 ? '' : 'ies'}`;
        }

        async function saveAll() {
            const blocks = document.querySelectorAll('.category-block');
            let isAllValid = true;

            const payloads = Array.from(blocks).map(block => {
                const id = block.id.replace('block-', '');
                const nameEl = document.getElementById(`subCategoryName-${id}`);
                const seqEl = document.getElementById(`subCategorySequence-${id}`);

                if (!nameEl.value.trim()) { nameEl.classList.add('is-invalid'); isAllValid = false; }
                if (!seqEl.value.trim()) { seqEl.classList.add('is-invalid'); isAllValid = false; }

                return {
                    SubCategoryName: nameEl.value.trim(),
                    SubCategorySequence: parseInt(seqEl.value),
                    CategoryId: TARGET_CATEGORY_ID,
                    SubCategoryImage: "",
                    SubCategoryDescription: "Default" // SQL NULL error se bachne ke liye
                };
            });

            if (!isAllValid) return;

            const btn = document.getElementById('saveBtn');
            btn.disabled = true;
            document.getElementById('saveSpinner').classList.remove('d-none');

            try {
                for (const p of payloads) {
                    const response = await fetch(API_BASE, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(p)
                    });

                    if (!response.ok) throw new Error("Server rejected one or more items.");
                }

                showToast('All items saved successfully!', 'success');
                setTimeout(() => window.location.href = `/FaqCategorys/SubCategoryList/${TARGET_CATEGORY_ID}`, 1500);

            } catch (e) {
                console.error(e);
                showToast('Error: Could not save data. Check SQL constraints.', 'danger');
            } finally {
                btn.disabled = false;
                document.getElementById('saveSpinner').classList.add('d-none');
            }
        }

        function resetAll() {
            if(confirm("Are you sure?")) location.reload();
        }

        function showToast(msg, type) {
            const toastEl = document.getElementById('appToast');
            document.getElementById('toastMsg').textContent = msg;
            toastEl.className = `toast align-items-center text-white border-0 bg-${type}`;
            bootstrap.Toast.getOrCreateInstance(toastEl).show();
        }

        document.addEventListener('DOMContentLoaded', addSubCategoryBlock);
    </script>
</body>
</html>