<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add SubCategory</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/FaqCategory.css" rel="stylesheet" />
</head>
<body>

    <!-- Page Header -->
    <div class="page-header">
        <h5><i class="bi bi-diagram-3 me-2"></i>Add SubCategory</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="FaqCategorys"><i class="bi bi-house"></i></a></li>
                <li class="breadcrumb-item"><a asp-action="SubCategoryList" asp-controller="FaqCategorys">SubCategory</a></li>
                <li class="breadcrumb-item active">Add SubCategory</li>
            </ol>
        </nav>
    </div>

    <!-- Main Content -->
    <div class="container-fluid px-4 py-4">
        <div class="card p-4">

            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold text-dark" style="font-size:0.95rem;">SubCategories</span>
                    <span class="count-badge" id="countBadge">1 subcategory</span>
                </div>
            </div>

            <div id="subCategoriesContainer" class="d-flex flex-column gap-3"></div>

            <div class="mt-3">
                <button class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 px-2 py-1" onclick="addSubCategoryBlock()">
                    <i class="bi bi-plus-circle-fill"></i>
                    Add SubCategory
                </button>
            </div>

            <hr class="mt-4" />

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-save" id="saveBtn" onclick="saveAll()">
                    <span class="spinner-border spinner-border-sm me-1 d-none" id="saveSpinner" role="status"></span>
                    Save All
                </button>
                <button type="button" class="btn btn-reset" onclick="resetAll()">Reset All</button>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="appToast" class="toast align-items-center text-white border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body fw-semibold" id="toastMsg"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const API_BASE = '/api/FaqSubCategory';
        const CAT_API = '/api/FaqCategory';
        let blockCounter = 0;
        let allCategories = [];

        // Load parent categories on page load
        async function loadCategories() {
            try {
                const res = await fetch(CAT_API);
                allCategories = await res.json();
            } catch (e) {
                allCategories = [];
            }
        }

        function buildCategoryOptions() {
            return allCategories.map(c =>
                `<option value="${c.id}">${c.categoryName}</option>`
            ).join('');
        }

        function createBlockHTML(id) {
            return `
            <div class="category-block" id="block-${id}">
                <div class="block-header">
                    <div class="block-title">
                        <span class="block-number" id="num-${id}">1</span>
                        SubCategory Details
                    </div>
                    <button class="btn-remove-block" onclick="removeBlock(${id})" id="removebtn-${id}" style="display:none">
                        <i class="bi bi-trash3"></i> Remove
                    </button>
                </div>

                <!-- Parent Category -->
                <div class="row mb-3 align-items-start">
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label">Parent Category <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-9 col-lg-10">
                        <select id="categoryId-${id}" class="form-select" onchange="clearErr('categoryId-${id}')">
                            <option value="">-- Select Category --</option>
                            ${buildCategoryOptions()}
                        </select>
                        <div class="invalid-feedback">Please select a parent category.</div>
                    </div>
                </div>

                <!-- SubCategory Name -->
                <div class="row mb-3 align-items-start">
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label">SubCategory Name <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-9 col-lg-10">
                        <input type="text" id="subCategoryName-${id}" class="form-control" placeholder="Enter SubCategory Name" oninput="clearErr('subCategoryName-${id}')" />
                        <div class="invalid-feedback">SubCategory Name is required.</div>
                    </div>
                </div>

                <!-- SubCategory Description -->
                <div class="row mb-3 align-items-start">
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label">SubCategory Description <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-9 col-lg-10">
                        <input type="text" id="subCategoryDescription-${id}" class="form-control" placeholder="Enter SubCategory Description" oninput="clearErr('subCategoryDescription-${id}')" />
                        <div class="invalid-feedback">SubCategory Description is required.</div>
                    </div>
                </div>

                <!-- SubCategory Image -->
                <div class="row mb-3 align-items-start">
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label">SubCategory Image</label>
                    </div>
                    <div class="col-md-9 col-lg-10">
                        <div class="custom-file-wrapper" onclick="document.getElementById('imageInput-${id}').click()">
                            <button type="button" class="custom-file-btn">Choose File</button>
                            <span class="custom-file-label" id="fileLabel-${id}">No file chosen</span>
                        </div>
                        <input type="file" id="imageInput-${id}" accept="image/*" style="display:none" onchange="handleFileChange(${id}, this)" />
                        <div id="previewWrapper-${id}" class="mt-2" style="display:none">
                            <img id="imgPreview-${id}" class="img-preview" src="#" alt="Preview" />
                        </div>
                    </div>
                </div>

                <!-- SubCategory Sequence -->
                <div class="row mb-3 align-items-start">
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label">Sequence <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-9 col-lg-10">
                        <input type="number" id="subCategorySequence-${id}" class="form-control" placeholder="Enter Sequence" min="1" oninput="clearErr('subCategorySequence-${id}')" />
                        <div class="invalid-feedback">Sequence is required and must be a positive number.</div>
                    </div>
                </div>
            </div>`;
        }

        function addSubCategoryBlock() {
            blockCounter++;
            const container = document.getElementById('subCategoriesContainer');
            const div = document.createElement('div');
            div.innerHTML = createBlockHTML(blockCounter);
            container.appendChild(div.firstElementChild);
            updateBlockNumbers();
        }

        function removeBlock(id) {
            const el = document.getElementById(`block-${id}`);
            if (el) {
                el.style.transition = 'opacity 0.18s, transform 0.18s';
                el.style.opacity = '0';
                el.style.transform = 'translateY(-8px)';
                setTimeout(() => { el.remove(); updateBlockNumbers(); }, 180);
            }
        }

        function updateBlockNumbers() {
            const blocks = document.querySelectorAll('.category-block');
            const count = blocks.length;
            blocks.forEach((block, i) => {
                const id = block.id.replace('block-', '');
                const numEl = document.getElementById(`num-${id}`);
                if (numEl) numEl.textContent = i + 1;
                const removeBtn = document.getElementById(`removebtn-${id}`);
                if (removeBtn) removeBtn.style.display = count > 1 ? '' : 'none';
            });
            const badge = document.getElementById('countBadge');
            badge.textContent = count === 1 ? '1 subcategory' : `${count} subcategories`;
        }

        function handleFileChange(id, input) {
            const file = input.files[0];
            const label = document.getElementById(`fileLabel-${id}`);
            const wrapper = document.getElementById(`previewWrapper-${id}`);
            const preview = document.getElementById(`imgPreview-${id}`);
            if (file) {
                label.textContent = file.name;
                label.style.color = '#1a2540';
                const reader = new FileReader();
                reader.onload = e => { preview.src = e.target.result; wrapper.style.display = 'block'; };
                reader.readAsDataURL(file);
            }
        }

        function clearErr(id) {
            const el = document.getElementById(id);
            if (el) el.classList.remove('is-invalid');
        }
        function setErr(id) {
            const el = document.getElementById(id);
            if (el) el.classList.add('is-invalid');
        }

        function validateBlock(id) {
            let valid = true;

            const catId = document.getElementById(`categoryId-${id}`)?.value;
            catId ? clearErr(`categoryId-${id}`) : (setErr(`categoryId-${id}`), valid = false);

            const name = document.getElementById(`subCategoryName-${id}`)?.value.trim();
            name ? clearErr(`subCategoryName-${id}`) : (setErr(`subCategoryName-${id}`), valid = false);

            const desc = document.getElementById(`subCategoryDescription-${id}`)?.value.trim();
            desc ? clearErr(`subCategoryDescription-${id}`) : (setErr(`subCategoryDescription-${id}`), valid = false);

            const seq = document.getElementById(`subCategorySequence-${id}`)?.value.trim();
            (seq && !isNaN(seq) && parseInt(seq) >= 1)
                ? clearErr(`subCategorySequence-${id}`)
                : (setErr(`subCategorySequence-${id}`), valid = false);

            return valid;
        }

        async function getBlockPayload(id) {
            let imageBase64 = null;
            const imageFile = document.getElementById(`imageInput-${id}`)?.files[0];
            if (imageFile) {
                imageBase64 = await new Promise(resolve => {
                    const reader = new FileReader();
                    reader.onload = e => resolve(e.target.result);
                    reader.readAsDataURL(imageFile);
                });
            }
            return {
                categoryId: parseInt(document.getElementById(`categoryId-${id}`).value),
                subCategoryName: document.getElementById(`subCategoryName-${id}`).value.trim(),
                subCategoryDescription: document.getElementById(`subCategoryDescription-${id}`).value.trim(),
                subCategoryImage: imageBase64,
                subCategorySequence: parseInt(document.getElementById(`subCategorySequence-${id}`).value.trim())
            };
        }

        function getAllBlockIds() {
            return [...document.querySelectorAll('.category-block')].map(b => b.id.replace('block-', ''));
        }

        async function saveAll() {
            const ids = getAllBlockIds();
            let allValid = true;
            ids.forEach(id => { if (!validateBlock(id)) allValid = false; });
            if (!allValid) { showToast('Please fix the errors before saving.', 'danger'); return; }

            const saveBtn = document.getElementById('saveBtn');
            const spinner = document.getElementById('saveSpinner');
            saveBtn.disabled = true;
            spinner.classList.remove('d-none');

            try {
                const payloads = await Promise.all(ids.map(id => getBlockPayload(id)));

                const results = await Promise.all(payloads.map(payload =>
                    fetch(API_BASE, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    }).then(r => r.json().then(data => ({ ok: r.ok, data })))
                ));

                const failed = results.filter(r => !r.ok);
                if (failed.length === 0) {
                    showToast(`${payloads.length} subcategor${payloads.length > 1 ? 'ies' : 'y'} saved successfully!`, 'success');
                    setTimeout(() => resetAll(), 1600);
                } else {
                    const errMsg = failed[0].data?.errors
                        ? Object.values(failed[0].data.errors).flat().join(' ')
                        : failed[0].data?.title || 'Some subcategories failed to save.';
                    showToast(errMsg, 'danger');
                }
            } catch (err) {
                showToast('Network error. Please try again.', 'danger');
            } finally {
                saveBtn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        function resetAll() {
            document.getElementById('subCategoriesContainer').innerHTML = '';
            blockCounter = 0;
            addSubCategoryBlock();
        }

        function showToast(msg, type = 'success') {
            const toastEl = document.getElementById('appToast');
            document.getElementById('toastMsg').textContent = msg;
            toastEl.className = `toast align-items-center text-white border-0 bg-${type}`;
            new bootstrap.Toast(toastEl, { delay: 3500 }).show();
        }

        // Init
        loadCategories().then(() => addSubCategoryBlock());
    </script>
</body>
</html>