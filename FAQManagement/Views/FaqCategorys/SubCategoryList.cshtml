@{
    ViewData["Title"] = "SubCategory List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-4">
    <div>
        <h5 class="fw-bold mb-0">SubCategory List</h5>
        <p class="text-muted small mb-0">Manage subcategories for your FAQ system.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary d-inline-flex align-items-center gap-1" onclick="goToAddSubCategory()">
            <i class="bi bi-plus-lg"></i> Add SubCategory
        </button>
        <a href="/FaqCategorys/List" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<input type="hidden" id="categoryFilter" value="" />

<div id="loadingSpinner" class="text-center p-5">
    <div class="spinner-border text-primary" role="status"></div>
</div>

<div id="noData" class="text-center p-5" style="display:none;">
    <i class="bi bi-inbox text-muted" style="font-size:2rem"></i>
    <p class="text-muted mt-2">No subcategories found.</p>
</div>

<div id="tableWrapper" class="bg-white rounded border p-3 shadow-sm mt-3" style="display:none;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;">#</th>
                    <th>SubCategory Name</th>
                    <th>Parent Category</th>
                    <th style="width: 280px;">Actions</th>
                </tr>
            </thead>
            <tbody id="subCategoryTableBody">
            </tbody>
        </table>
    </div>
</div>

<template id="rowTemplate">
    <tr>
        <td class="text-muted row-index"></td>
        <td>
            <div class="fw-semibold text-dark row-name"></div>
            <div class="small text-secondary row-desc"></div>
        </td>
        <td>
            <span class="badge bg-light text-primary border rounded-pill px-3 py-1 fw-medium">
                <i class="bi bi-folder2 me-1"></i> <span class="row-parent"></span>
            </span>
        </td>
        <td>
            <div class="d-flex gap-2">
                <a href="#" class="btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-1 btn-link-add">
                    <i class="bi bi-plus-circle"></i> Add FAQ
                </a>
                <a href="#" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1 btn-link-read">
                    <i class="bi bi-eye"></i> View
                </a>
                <a href="#" class="btn btn-sm btn-outline-primary btn-link-edit">
                    <i class="bi bi-pencil"></i>
                </a>
                <button class="btn btn-sm btn-outline-danger btn-delete-trigger">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </td>
    </tr>
</template>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body text-center p-4">
                <i class="bi bi-exclamation-circle text-danger" style="font-size:2.5rem"></i>
                <h6 class="mt-3">Delete this item?</h6>
                <p class="text-muted small">This action cannot be undone.</p>
                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-light flex-fill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger flex-fill" id="confirmDeleteBtn">
                        <span id="deleteSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="appToast" class="toast align-items-center text-white border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="toastMsg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script>
    const API_BASE = '/api/FaqSubCategory';
    let allSubCategories = [];
    let deleteTargetId = null;
    let deleteModalInstance = null;

    // Get Category ID from URL (last part of path)
    const pathParts = window.location.pathname.split('/');
    const TARGET_CATEGORY_ID = parseInt(pathParts[pathParts.length - 1]) || 0;

    document.addEventListener('DOMContentLoaded', () => {
        deleteModalInstance = new bootstrap.Modal(document.getElementById('deleteModal'));
        document.getElementById('categoryFilter').value = TARGET_CATEGORY_ID;

        document.getElementById('confirmDeleteBtn').onclick = confirmDelete;

        loadSubCategories();
    });

    async function loadSubCategories() {
        try {
            const res = await fetch(API_BASE);
            if (!res.ok) throw new Error();
            allSubCategories = await res.json();
            applyFilter();
        } catch (e) {
            showToast('Failed to load data.', 'danger');
        } finally {
            document.getElementById('loadingSpinner').style.display = 'none';
        }
    }

    function applyFilter() {
        const filterVal = document.getElementById('categoryFilter').value;
        const filtered = filterVal > 0
            ? allSubCategories.filter(s => s.categoryId == filterVal)
            : allSubCategories;

        if (filtered.length === 0) {
            document.getElementById('noData').style.display = 'block';
            document.getElementById('tableWrapper').style.display = 'none';
        } else {
            document.getElementById('noData').style.display = 'none';
            document.getElementById('tableWrapper').style.display = 'block';
            renderTable(filtered);
        }
    }

    function renderTable(subCategories) {
        const tbody = document.getElementById('subCategoryTableBody');
        const template = document.getElementById('rowTemplate');
        tbody.innerHTML = "";

        subCategories.forEach((sub, index) => {
            const clone = template.content.cloneNode(true);
            clone.querySelector('.row-index').textContent = index + 1;
            clone.querySelector('.row-name').textContent = sub.subCategoryName || 'N/A';
            clone.querySelector('.row-parent').textContent = sub.categoryName || 'General';
            clone.querySelector('.row-desc').textContent = sub.description || '';

            clone.querySelector('.btn-link-edit').href = `/FaqCategorys/EditSubCategory/${sub.id}`;
            clone.querySelector('.btn-link-read').href = `/FAQ/List/${sub.id}`;
            clone.querySelector('.btn-link-add').href = `/FAQ/Index?categoryId=${sub.categoryId}&subCategoryId=${sub.id}`;

            const deleteBtn = clone.querySelector('.btn-delete-trigger');
            deleteBtn.onclick = () => {
                deleteTargetId = sub.id;
                deleteModalInstance.show();
            };

            tbody.appendChild(clone);
        });
    }

    function goToAddSubCategory() {
        window.location.href = `/FaqCategorys/AddSubCategory/${TARGET_CATEGORY_ID}`;
    }

    async function confirmDelete() {
        const btn = document.getElementById('confirmDeleteBtn');
        const spinner = document.getElementById('deleteSpinner');

        btn.disabled = true;
        spinner.classList.remove('d-none');

        try {
            const res = await fetch(`${API_BASE}/${deleteTargetId}`, { method: 'DELETE' });
            if (res.ok) {
                deleteModalInstance.hide();
                allSubCategories = allSubCategories.filter(s => s.id !== deleteTargetId);
                applyFilter();
                showToast('Deleted successfully!');
            } else {
                throw new Error();
            }
        } catch (e) {
            showToast('Could not delete.', 'danger');
        } finally {
            btn.disabled = false;
            spinner.classList.add('d-none');
        }
    }

    function showToast(msg, type = 'success') {
        const toastEl = document.getElementById('appToast');
        const toastMsg = document.getElementById('toastMsg');
        toastMsg.textContent = msg;
        toastEl.className = `toast align-items-center text-white border-0 bg-${type}`;
        bootstrap.Toast.getOrCreateInstance(toastEl).show();
    }
</script>