@{
    ViewData["Title"] = "SubCategory List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .category-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #dee2e6;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        transition: transform 0.2s;
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

    .card-img-top-container {
        width: 100%;
        height: 160px;
        background: #f8f9fa;
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .card-img-top-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .card-body-content {
        padding: 15px;
        text-align: center;
    }

    .category-title {
        font-weight: 600;
        font-size: 1rem;
        margin-bottom: 4px;
        color: #333;
    }

    .category-desc {
        font-size: 0.82rem;
        color: #6c757d;
        height: 36px;
        overflow: hidden;
    }

    .parent-badge {
        font-size: 0.72rem;
        background: #e8f0fe;
        color: #1a73e8;
        border-radius: 20px;
        padding: 2px 10px;
        display: inline-block;
        margin-bottom: 6px;
    }

    .card-footer-actions {
        padding: 12px;
        background: #fcfcfc;
        border-top: 1px solid #eee;
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn-action {
        flex: 1;
        padding: 6px;
        border-radius: 5px;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .btn-add-main {
        background-color: #0D6EFD;
        color: white;
        padding: 8px 16px;
        border-radius: 5px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .filter-bar {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 15px;
    }

    .no-image-placeholder {
        color: #adb5bd;
        font-size: 0.85rem;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold">SubCategory List</h5>
    <a class="btn-add-main" asp-action="AddSubCategory" asp-controller="FaqCategorys">
        <i class="bi bi-plus-lg"></i> Add SubCategory
    </a>
</div>

<!-- Filter -->
<div class="filter-bar">
    <label class="fw-semibold" style="font-size:0.9rem">Filter by Category:</label>
    <select id="categoryFilter" class="form-select form-select-sm" style="width:220px" onchange="applyFilter()">
        <option value="">All Categories</option>
    </select>
    <span id="totalCount" class="text-muted" style="font-size:0.85rem"></span>
</div>

<!-- Loading -->
<div id="loadingSpinner" class="text-center p-5">
    <div class="spinner-border text-primary" role="status"></div>
</div>

<!-- No Data -->
<div id="noData" class="text-center p-5" style="display:none;">
    <i class="bi bi-inbox text-muted" style="font-size:2rem"></i>
    <p class="text-muted mt-2">No subcategories found.</p>
</div>

<!-- Grid -->
<div id="categoryGrid" class="category-grid" style="display:none;"></div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-body text-center p-4">
                <i class="bi bi-exclamation-circle text-danger" style="font-size:2.5rem"></i>
                <h6 class="mt-3">Are you sure you want to delete?</h6>
                <p class="text-muted" style="font-size:0.85rem">This action cannot be undone.</p>
                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-light flex-fill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger flex-fill" onclick="confirmDelete()">
                        <span id="deleteSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="appToast" class="toast align-items-center text-white border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="toastMsg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script>
    const API_BASE = '/api/FaqSubCategory';
    const CAT_API = '/api/FaqCategory';
    let allSubCategories = [];
    let deleteTargetId = null;
    let deleteModalInstance = null;

    document.addEventListener('DOMContentLoaded', async () => {
        await loadCategoryFilter();
        await loadSubCategories();
    });

    async function loadCategoryFilter() {
        try {
            const res = await fetch(CAT_API);
            const cats = await res.json();
            const sel = document.getElementById('categoryFilter');
            cats.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.id;
                opt.textContent = c.categoryName;
                sel.appendChild(opt);
            });
        } catch (e) {
            console.error('Failed to load categories', e);
        }
    }

    async function loadSubCategories() {
        try {
            const res = await fetch(API_BASE);
            allSubCategories = await res.json();
            document.getElementById('loadingSpinner').style.display = 'none';
            applyFilter();
        } catch (e) {
            document.getElementById('loadingSpinner').style.display = 'none';
            showToast('Failed to load subcategories.', 'danger');
        }
    }

    function applyFilter() {
        const filterVal = document.getElementById('categoryFilter').value;
        const filtered = filterVal
            ? allSubCategories.filter(s => s.categoryId == filterVal)
            : allSubCategories;

        document.getElementById('totalCount').textContent =
            filtered.length === 0 ? '' :
            filtered.length === 1 ? '1 subcategory' : `${filtered.length} subcategories`;

        if (filtered.length === 0) {
            document.getElementById('noData').style.display = 'block';
            document.getElementById('categoryGrid').style.display = 'none';
        } else {
            document.getElementById('noData').style.display = 'none';
            renderGrid(filtered);
        }
    }

    function renderGrid(subCategories) {
        const grid = document.getElementById('categoryGrid');
        grid.innerHTML = '';

        subCategories.forEach(sub => {
            const html = `
                <div class="category-card" id="card-${sub.id}">
                    <div class="card-img-top-container">
                        ${sub.subCategoryImage
                            ? `<img src="${sub.subCategoryImage}" alt="${sub.subCategoryName}"
                                onerror="this.parentElement.innerHTML='<span class=no-image-placeholder>No Image</span>'">`
                            : `<span class="no-image-placeholder"><i class="bi bi-image" style="font-size:2rem"></i></span>`}
                    </div>
                    <div class="card-body-content">
                        <div class="parent-badge">
                            <i class="bi bi-folder2"></i> ${sub.categoryName || 'Unknown Category'}
                        </div>
                        <div class="category-title">${sub.subCategoryName || ''}</div>
                        <div class="category-desc">${sub.subCategoryDescription || ''}</div>
                    </div>
                    <div class="card-footer-actions">
                        <a href="/FaqCategorys/EditSubCategory/${sub.id}" class="btn btn-primary btn-action">
                            <i class="bi bi-pencil-fill"></i> Edit
                        </a>
                        <button class="btn btn-danger btn-action" onclick="openDeleteModal(${sub.id})">
                            <i class="bi bi-trash-fill"></i> Delete
                        </button>
                    </div>
                </div>`;
            grid.insertAdjacentHTML('beforeend', html);
        });

        grid.style.display = 'grid';
    }

    function openDeleteModal(id) {
        deleteTargetId = id;
        deleteModalInstance = new bootstrap.Modal(document.getElementById('deleteModal'));
        deleteModalInstance.show();
    }

    async function confirmDelete() {
        if (!deleteTargetId) return;

        const spinner = document.getElementById('deleteSpinner');
        spinner.classList.remove('d-none');

        try {
            const res = await fetch(`${API_BASE}/${deleteTargetId}`, { method: 'DELETE' });
            if (res.ok) {
                deleteModalInstance.hide();
                // Remove card from UI without full reload
                const card = document.getElementById(`card-${deleteTargetId}`);
                if (card) {
                    card.style.transition = 'opacity 0.2s';
                    card.style.opacity = '0';
                    setTimeout(() => {
                        card.remove();
                        allSubCategories = allSubCategories.filter(s => s.id !== deleteTargetId);
                        applyFilter();
                    }, 200);
                }
                showToast('SubCategory deleted successfully!', 'success');
            } else {
                showToast('Failed to delete. Try again.', 'danger');
            }
        } catch (e) {
            showToast('Network error. Try again.', 'danger');
        } finally {
            spinner.classList.add('d-none');
            deleteTargetId = null;
        }
    }

    function showToast(msg, type = 'success') {
        const toastEl = document.getElementById('appToast');
        document.getElementById('toastMsg').textContent = msg;
        toastEl.className = `toast align-items-center text-white border-0 bg-${type}`;
        new bootstrap.Toast(toastEl, { delay: 3000 }).show();
    }
</script>