@{
    ViewData["Title"] = "SubCategory List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .category-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #dee2e6;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        transition: transform 0.2s;
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

    .card-img-top-container {
        width: 100%;
        height: 160px;
        background: #f8f9fa;
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .card-img-top-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .card-body-content {
        padding: 15px;
        text-align: center;
    }

    .category-title {
        font-weight: 600;
        font-size: 1rem;
        margin-bottom: 4px;
        color: #333;
    }

    .category-desc {
        font-size: 0.82rem;
        color: #6c757d;
        height: 36px;
        overflow: hidden;
    }

    .parent-badge {
        font-size: 0.72rem;
        background: #e8f0fe;
        color: #1a73e8;
        border-radius: 20px;
        padding: 2px 10px;
        display: inline-block;
        margin-bottom: 6px;
    }

    .card-footer-actions {
        padding: 12px;
        background: #fcfcfc;
        border-top: 1px solid #eee;
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn-action {
        flex: 1;
        padding: 6px;
        border-radius: 5px;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .btn-add-main {
        background-color: #0D6EFD;
        color: white;
        padding: 8px 16px;
        border-radius: 5px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .no-image-placeholder {
        color: #adb5bd;
        font-size: 0.85rem;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold">SubCategory List</h5>
    <div class="d-flex gap-2">
        <button class="btn-add-main" onclick="goToAddSubCategory()">
            <i class="bi bi-plus-lg"></i> Add SubCategory
        </button>
        <a asp-action="List" asp-controller="FaqCategorys" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Main Categories
        </a>
    </div>
</div>

<input type="hidden" id="categoryFilter" value="" />

<div id="loadingSpinner" class="text-center p-5">
    <div class="spinner-border text-primary" role="status"></div>
</div>

<div id="noData" class="text-center p-5" style="display:none;">
    <i class="bi bi-inbox text-muted" style="font-size:2rem"></i>
    <p class="text-muted mt-2">No subcategories found for this category.</p>
</div>

<div id="categoryGrid" class="category-grid" style="display:none;"></div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-body text-center p-4">
                <i class="bi bi-exclamation-circle text-danger" style="font-size:2.5rem"></i>
                <h6 class="mt-3">Are you sure?</h6>
                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-light flex-fill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger flex-fill" onclick="confirmDelete()">
                        <span id="deleteSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="appToast" class="toast align-items-center text-white border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="toastMsg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script>
    const API_BASE = '/api/FaqSubCategory';
    let allSubCategories = [];
    let deleteTargetId = null;
    let deleteModalInstance = null;

    // URL se Category ID nikalna
    const getUrlId = () => {
        const parts = window.location.pathname.split('/');
        return parseInt(parts[parts.length - 1]) || 0;
    };
    const TARGET_CATEGORY_ID = getUrlId();

    document.addEventListener('DOMContentLoaded', async () => {
        // Dropdown ki jagah hidden input mein ID set kar rahe hain logic maintain karne ke liye
        document.getElementById('categoryFilter').value = TARGET_CATEGORY_ID;
        await loadSubCategories();
    });

    async function loadSubCategories() {
        try {
            const res = await fetch(API_BASE);
            allSubCategories = await res.json();
            document.getElementById('loadingSpinner').style.display = 'none';
            applyFilter();
        } catch (e) {
            document.getElementById('loadingSpinner').style.display = 'none';
            showToast('Failed to load.', 'danger');
        }
    }

    function applyFilter() {
        const filterVal = document.getElementById('categoryFilter').value;
        // Agar URL mein ID hai (TARGET_CATEGORY_ID > 0), toh filter apply karo, warna sab dikhao
        const filtered = filterVal > 0
            ? allSubCategories.filter(s => s.categoryId == filterVal)
            : allSubCategories;

        if (filtered.length === 0) {
            document.getElementById('noData').style.display = 'block';
            document.getElementById('categoryGrid').style.display = 'none';
        } else {
            document.getElementById('noData').style.display = 'none';
            renderGrid(filtered);
        }
    }

    function renderGrid(subCategories) {
        const grid = document.getElementById('categoryGrid');
        grid.innerHTML = '';
        subCategories.forEach(sub => {
            const html = `
                <div class="category-card" id="card-${sub.id}">
                    <div class="card-img-top-container">
                        ${sub.subCategoryImage
                            ? `<img src="${sub.subCategoryImage}" alt="${sub.subCategoryName}">`
                            : `<span class="no-image-placeholder"><i class="bi bi-image" style="font-size:2rem"></i></span>`}
                    </div>
                    <div class="card-body-content">
                        <div class="parent-badge"><i class="bi bi-folder2"></i> ${sub.categoryName || 'General'}</div>
                        <div class="category-title">${sub.subCategoryName || ''}</div>
                        <div class="category-desc">${sub.subCategoryDescription || ''}</div>
                    </div>
                    <div class="card-footer-actions">
                        <a href="/FaqCategorys/EditSubCategory/${sub.id}" class="btn btn-primary btn-action">
                            <i class="bi bi-pencil-fill"></i> Edit
                        </a>
                        <button class="btn btn-danger btn-action" onclick="openDeleteModal(${sub.id})">
                            <i class="bi bi-trash-fill"></i> Delete
                        </button>
                    </div>
                </div>`;
            grid.insertAdjacentHTML('beforeend', html);
        });
        grid.style.display = 'grid';
    }

    function goToAddSubCategory() {
        window.location.href = `/FaqCategorys/AddSubCategory/${TARGET_CATEGORY_ID}`;
    }

    function openDeleteModal(id) {
        deleteTargetId = id;
        deleteModalInstance = new bootstrap.Modal(document.getElementById('deleteModal'));
        deleteModalInstance.show();
    }

    async function confirmDelete() {
        const spinner = document.getElementById('deleteSpinner');
        spinner.classList.remove('d-none');
        try {
            const res = await fetch(`${API_BASE}/${deleteTargetId}`, { method: 'DELETE' });
            if (res.ok) {
                deleteModalInstance.hide();
                allSubCategories = allSubCategories.filter(s => s.id !== deleteTargetId);
                applyFilter();
                showToast('Deleted successfully!', 'success');
            }
        } catch (e) { showToast('Error occurred.', 'danger'); }
        finally { spinner.classList.add('d-none'); }
    }

    function showToast(msg, type = 'success') {
        const toastEl = document.getElementById('appToast');
        document.getElementById('toastMsg').textContent = msg;
        toastEl.className = `toast align-items-center text-white border-0 bg-${type}`;
        new bootstrap.Toast(toastEl).show();
    }
</script>