@{
    ViewData["Title"] = "SubCategory List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table-container {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #dee2e6;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        margin-top: 20px;
    }

    .table thead {
        background-color: #f8f9fa;
    }

    .table th {
        font-weight: 600;
        color: #333;
        border-top: none;
    }

    .parent-badge {
        font-size: 0.75rem;
        background: #e8f0fe;
        color: #1a73e8;
        border-radius: 20px;
        padding: 4px 12px;
        display: inline-block;
        font-weight: 500;
    }

    .sub-title {
        font-weight: 600;
        color: #212529;
    }

    .sub-desc {
        font-size: 0.85rem;
        color: #6c757d;
        max-width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Action Buttons Styling */
    .btn-table-action {
        font-size: 0.75rem;
        padding: 4px 10px;
        font-weight: 500;
        border-radius: 4px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s;
    }

    .btn-read {
        background-color: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
    }

        .btn-read:hover {
            background-color: #16a34a;
            color: white;
        }

    .btn-add-item {
        background-color: #fff7ed;
        color: #ea580c;
        border: 1px solid #ffedd5;
    }

        .btn-add-item:hover {
            background-color: #ea580c;
            color: white;
        }

    .btn-add-main {
        background-color: #0D6EFD;
        color: white;
        padding: 8px 16px;
        border-radius: 5px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: none;
    }

        .btn-add-main:hover {
            background-color: #0b5ed7;
            color: white;
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="fw-bold mb-0">SubCategory List</h5>
        <p class="text-muted small mb-0">Manage and view subcategories for the selected category.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn-add-main" onclick="goToAddSubCategory()">
            <i class="bi bi-plus-lg"></i> Add SubCategory
        </button>
        <a asp-action="List" asp-controller="FaqCategorys" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Main Categories
        </a>
    </div>
</div>

<input type="hidden" id="categoryFilter" value="" />

<div id="loadingSpinner" class="text-center p-5">
    <div class="spinner-border text-primary" role="status"></div>
</div>

<div id="noData" class="text-center p-5" style="display:none;">
    <i class="bi bi-inbox text-muted" style="font-size:2rem"></i>
    <p class="text-muted mt-2">No subcategories found for this category.</p>
</div>

<div id="tableWrapper" class="table-container" style="display:none;">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>SubCategory Name</th>
                    <th>Description</th>
                    <th>Parent Category</th>
                    <th class="text-end" style="min-width: 250px;">Actions</th>
                </tr>
            </thead>
            <tbody id="subCategoryTableBody">
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-body text-center p-4">
                <i class="bi bi-exclamation-circle text-danger" style="font-size:2.5rem"></i>
                <h6 class="mt-3">Are you sure?</h6>
                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-light flex-fill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger flex-fill" onclick="confirmDelete()">
                        <span id="deleteSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="appToast" class="toast align-items-center text-white border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="toastMsg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script>
    const API_BASE = '/api/FaqSubCategory';
    let allSubCategories = [];
    let deleteTargetId = null;
    let deleteModalInstance = null;

    const getUrlId = () => {
        const parts = window.location.pathname.split('/');
        return parseInt(parts[parts.length - 1]) || 0;
    };
    const TARGET_CATEGORY_ID = getUrlId();

    document.addEventListener('DOMContentLoaded', async () => {
        document.getElementById('categoryFilter').value = TARGET_CATEGORY_ID;
        await loadSubCategories();
    });

    async function loadSubCategories() {
        try {
            const res = await fetch(API_BASE);
            allSubCategories = await res.json();
            document.getElementById('loadingSpinner').style.display = 'none';
            applyFilter();
        } catch (e) {
            document.getElementById('loadingSpinner').style.display = 'none';
            showToast('Failed to load data.', 'danger');
        }
    }

    function applyFilter() {
        const filterVal = document.getElementById('categoryFilter').value;
        const filtered = filterVal > 0
            ? allSubCategories.filter(s => s.categoryId == filterVal)
            : allSubCategories;

        if (filtered.length === 0) {
            document.getElementById('noData').style.display = 'block';
            document.getElementById('tableWrapper').style.display = 'none';
        } else {
            document.getElementById('noData').style.display = 'none';
            renderTable(filtered);
        }
    }

    function renderTable(subCategories) {
        const tbody = document.getElementById('subCategoryTableBody');
        tbody.innerHTML = '';

        subCategories.forEach((sub, index) => {
            const row = `
                <tr id="row-${sub.id}">
                    <td class="text-muted">${index + 1}</td>
                    <td>
                        <div class="sub-title">${sub.subCategoryName || 'N/A'}</div>
                    </td>
                    <td>
                        <div class="sub-desc" title="${sub.subCategoryDescription || ''}">
                            ${sub.subCategoryDescription || 'No description'}
                        </div>
                    </td>
                    <td>
                        <span class="parent-badge">
                            <i class="bi bi-folder2 me-1"></i> ${sub.categoryName || 'General'}
                        </span>
                    </td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end align-items-center gap-2">
                            <a href="#" class="btn-table-action btn-add-item">
                                <i class="bi bi-plus-circle"></i> Add
                            </a>
                            <a href="#" class="btn-table-action btn-read">
                                <i class="bi bi-eye"></i> Read
                            </a>

                            <div class="btn-group ms-2">
                                <a href="/FaqCategorys/EditSubCategory/${sub.id}" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn btn-sm btn-outline-danger" onclick="openDeleteModal(${sub.id})" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>`;
            tbody.insertAdjacentHTML('beforeend', row);
        });
        document.getElementById('tableWrapper').style.display = 'block';
    }

    function goToAddSubCategory() {
        window.location.href = `/FaqCategorys/AddSubCategory/${TARGET_CATEGORY_ID}`;
    }

    function openDeleteModal(id) {
        deleteTargetId = id;
        deleteModalInstance = new bootstrap.Modal(document.getElementById('deleteModal'));
        deleteModalInstance.show();
    }

    async function confirmDelete() {
        const spinner = document.getElementById('deleteSpinner');
        spinner.classList.remove('d-none');
        try {
            const res = await fetch(`${API_BASE}/${deleteTargetId}`, { method: 'DELETE' });
            if (res.ok) {
                deleteModalInstance.hide();
                allSubCategories = allSubCategories.filter(s => s.id !== deleteTargetId);
                applyFilter();
                showToast('Deleted successfully!', 'success');
            }
        } catch (e) {
            showToast('Error deleting item.', 'danger');
        } finally {
            spinner.classList.add('d-none');
        }
    }

    function showToast(msg, type = 'success') {
        const toastEl = document.getElementById('appToast');
        document.getElementById('toastMsg').textContent = msg;
        toastEl.className = `toast align-items-center text-white border-0 bg-${type}`;
        new bootstrap.Toast(toastEl).show();
    }
</script>