@{
    ViewData["Title"] = "Add Category";
}

<style>
    /* Modern UI Tweaks */
    .category-block {
        border: 1px solid #e0e6ed;
        border-radius: 12px;
        background-color: #ffffff;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .category-block:hover {
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            border-color: #d1d9e6;
        }

    .block-header {
        background-color: #f8f9fa;
        padding: 12px 20px;
        border-bottom: 1px solid #e0e6ed;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .block-number {
        background: #0d6efd;
        color: white;
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        font-size: 0.8rem;
        margin-right: 8px;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25 darkgrey;
    }

    .img-preview {
        border-radius: 8px;
        max-height: 100px;
        border: 2px solid #f0f0f0;
    }

    .btn-remove-block {
        color: #dc3545;
        background: none;
        border: none;
        font-size: 0.9rem;
        font-weight: 500;
    }

        .btn-remove-block:hover {
            text-decoration: underline;
        }
</style>

<div class="page-header mb-4">
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <h5 class="fw-bold mb-1"><i class="bi bi-plus-square-dotted me-2 text-primary"></i>Add New Category</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-action="List" asp-controller="FaqCategorys" class="text-decoration-none"><i class="bi bi-house"></i></a></li>
                    <li class="breadcrumb-item">Category</li>
                    <li class="breadcrumb-item active">Add New</li>
                </ol>
            </nav>
        </div>
        <span class="badge bg-light text-dark border py-2 px-3 shadow-sm" id="countBadge">1 Category</span>
    </div>
</div>

<div class="container-fluid">
    <div class="card border-0 shadow-sm p-4 rounded-4">

        <div id="categoriesContainer" class="d-flex flex-column gap-4"></div>

        <div class="mt-4 text-center">
            <button class="btn btn-outline-primary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2 shadow-sm" onclick="addCategoryBlock()">
                <i class="bi bi-plus-circle"></i> Add Another Block
            </button>
        </div>

        <hr class="my-5 opacity-25" />

        <div class="d-flex justify-content-end gap-3">
            <button type="button" class="btn btn-light border px-4 rounded-3" onclick="resetAll()">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset All
            </button>
            <button type="button" class="btn btn-primary px-5 rounded-3 shadow" id="saveBtn" onclick="saveAllCategories()">
                <span class="spinner-border spinner-border-sm me-2 d-none" id="saveSpinner" role="status"></span>
                <i class="bi bi-cloud-check me-1"></i> Save Everything
            </button>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="appToast" class="toast align-items-center text-white border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-medium" id="toastMsg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_BASE = '/api/FaqCategory';
        const LIST_PAGE_URL = '@Url.Action("List", "FaqCategorys")'; // Redirect path
        let blockCounter = 0;

        function createBlockHTML(id) {
            return `
            <div class="category-block animate__animated animate__fadeInUp" id="block-${id}">
                <div class="block-header">
                    <div class="fw-bold text-dark d-flex align-items-center">
                        <span class="block-number" id="num-${id}">1</span>
                        Category Information
                    </div>
                    <button class="btn-remove-block" onclick="removeBlock(${id})" id="removebtn-${id}" style="display:none">
                        <i class="bi bi-trash3 me-1"></i>Remove
                    </button>
                </div>

                <div class="p-4">
                    <div class="row g-4">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label class="form-label fw-semibold small text-uppercase text-muted">Category Name <span class="text-danger">*</span></label>
                                <input type="text" id="categoryName-${id}" class="form-control form-control-lg" placeholder="e.g. Technical Support" oninput="clearErr('categoryName-${id}')" />
                                <div class="invalid-feedback">Name is required.</div>
                            </div>
                            <div>
                                <label class="form-label fw-semibold small text-uppercase text-muted">Description <span class="text-danger">*</span></label>
                                <textarea id="categoryDescription-${id}" class="form-control" rows="3" placeholder="Explain what this category covers..." oninput="clearErr('categoryDescription-${id}')"></textarea>
                                <div class="invalid-feedback">Description is required.</div>
                            </div>
                        </div>

                        <div class="col-md-4 border-start ps-md-4">
                            <div class="mb-4 text-center">
                                <label class="form-label fw-semibold small text-uppercase text-muted d-block text-start">Category Image</label>
                                <div class="border rounded-3 p-3 bg-light position-relative" style="cursor:pointer" onclick="document.getElementById('imageInput-${id}').click()">
                                    <div id="fileInfo-${id}">
                                        <i class="bi bi-image text-muted" style="font-size: 2rem;"></i>
                                        <p class="small text-muted mb-0 mt-2" id="fileLabel-${id}">Click to Upload</p>
                                    </div>
                                    <div id="previewWrapper-${id}" class="mt-2" style="display:none">
                                        <img id="imgPreview-${id}" class="img-preview w-100 object-fit-contain" src="#" alt="Preview" />
                                    </div>
                                </div>
                                <input type="file" id="imageInput-${id}" accept="image/*" style="display:none" onchange="handleFileChange(${id}, this)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small text-uppercase text-muted">Display Sequence</label>
                                <input type="number" id="categorySequence-${id}" class="form-control bg-light text-center fw-bold" readonly />
                                <small class="text-muted" style="font-size:0.7rem">Automatic assigned order</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>`;
        }

        function addCategoryBlock() {
            blockCounter++;
            const container = document.getElementById('categoriesContainer');
            const div = document.createElement('div');
            div.innerHTML = createBlockHTML(blockCounter);
            container.appendChild(div.firstElementChild);
            updateBlockNumbers();
        }

        function removeBlock(id) {
            const el = document.getElementById(`block-${id}`);
            if (el) {
                el.style.opacity = '0';
                el.style.transform = 'scale(0.95)';
                setTimeout(() => { el.remove(); updateBlockNumbers(); }, 200);
            }
        }

        function updateBlockNumbers() {
            const blocks = document.querySelectorAll('.category-block');
            blocks.forEach((block, i) => {
                const id = block.id.replace('block-', '');
                document.getElementById(`num-${id}`).textContent = i + 1;
                document.getElementById(`categorySequence-${id}`).value = i + 1;
                document.getElementById(`removebtn-${id}`).style.display = blocks.length > 1 ? 'block' : 'none';
            });
            document.getElementById('countBadge').textContent = `${blocks.length} Category${blocks.length > 1 ? 'ies' : ''}`;
        }

        function handleFileChange(id, input) {
            const file = input.files[0];
            const label = document.getElementById(`fileLabel-${id}`);
            const preview = document.getElementById(`imgPreview-${id}`);
            const wrapper = document.getElementById(`previewWrapper-${id}`);
            const info = document.getElementById(`fileInfo-${id}`);

            if (file) {
                label.textContent = file.name;
                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    wrapper.style.display = 'block';
                    info.classList.add('d-none');
                };
                reader.readAsDataURL(file);
            }
        }

        function clearErr(id) { document.getElementById(id)?.classList.remove('is-invalid'); }
        function setErr(id) { document.getElementById(id)?.classList.add('is-invalid'); }

        async function saveAllCategories() {
            const blocks = document.querySelectorAll('.category-block');
            const ids = Array.from(blocks).map(b => b.id.replace('block-', ''));

            let allValid = true;
            ids.forEach(id => {
                if (!document.getElementById(`categoryName-${id}`).value.trim()) { setErr(`categoryName-${id}`); allValid = false; }
                if (!document.getElementById(`categoryDescription-${id}`).value.trim()) { setErr(`categoryDescription-${id}`); allValid = false; }
            });

            if (!allValid) {
                showToast("Please fill all mandatory fields.", "danger");
                return;
            }

            const saveBtn = document.getElementById('saveBtn');
            saveBtn.disabled = true;
            document.getElementById('saveSpinner').classList.remove('d-none');

            try {
                const payloads = await Promise.all(ids.map(async id => {
                    let img = null;
                    const fileInput = document.getElementById(`imageInput-${id}`);
                    if (fileInput.files[0]) {
                        img = await new Promise(r => {
                            const reader = new FileReader();
                            reader.onload = e => r(e.target.result);
                            reader.readAsDataURL(fileInput.files[0]);
                        });
                    }
                    return {
                        categoryName: document.getElementById(`categoryName-${id}`).value,
                        categoryDescription: document.getElementById(`categoryDescription-${id}`).value,
                        categorySequence: parseInt(document.getElementById(`categorySequence-${id}`).value),
                        categoryImage: img
                    };
                }));

                const results = await Promise.all(payloads.map(p =>
                    fetch(API_BASE, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(p)
                    })
                ));

                if (results.every(r => r.ok)) {
                    showToast('Successfully Saved! Redirecting...');
                    // Redirect to list page after 1.5 seconds
                    setTimeout(() => {
                        window.location.href = LIST_PAGE_URL;
                    }, 1500);
                } else {
                    showToast('Error saving some categories.', 'danger');
                    saveBtn.disabled = false;
                    document.getElementById('saveSpinner').classList.add('d-none');
                }
            } catch (e) {
                showToast('Network error occurred.', 'danger');
                saveBtn.disabled = false;
                document.getElementById('saveSpinner').classList.add('d-none');
            }
        }

        function resetAll() {
            if(confirm("Are you sure you want to clear all data?")) {
                document.getElementById('categoriesContainer').innerHTML = '';
                blockCounter = 0;
                addCategoryBlock();
            }
        }

        function showToast(msg, type = 'success') {
            const toastEl = document.getElementById('appToast');
            document.getElementById('toastMsg').textContent = msg;
            toastEl.className = `toast align-items-center text-white border-0 bg-${type}`;
            const bsToast = new bootstrap.Toast(toastEl);
            bsToast.show();
        }

        document.addEventListener('DOMContentLoaded', () => addCategoryBlock());
    </script>
}