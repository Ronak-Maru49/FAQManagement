<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add Category</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/FaqCategory.css" rel="stylesheet" />
</head>
<body>

    <!-- Page Header -->
    <div class="page-header">
        <h5><i class="bi bi-grid me-2"></i>Add Category</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="FaqCategorys"><i class="bi bi-house"></i></a></li>
                <li class="breadcrumb-item"><a href="#">Category</a></li>
                <li class="breadcrumb-item active">Add Category</li>
            </ol>
        </nav>
    </div>

    <!-- Main Content -->
    <div class="container-fluid px-4 py-4">
        <div class="card p-4">

            <!-- Header row -->
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold text-dark" style="font-size:0.95rem;">Categories</span>
                    <span class="count-badge" id="countBadge">1 category</span>
                </div>
            </div>

            <!-- Category blocks container -->
            <div id="categoriesContainer" class="d-flex flex-column gap-3"></div>

            <!-- Add More -->
            <div class="mt-3">
                <button class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 px-2 py-1" onclick="addCategoryBlock()">
                    <i class="bi bi-plus-circle-fill"></i>
                    Add Category
                </button>
            </div>

            <hr class="mt-4" />

            <!-- Action Buttons -->
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-save" id="saveBtn" onclick="saveAllCategories()">
                    <span class="spinner-border spinner-border-sm me-1 d-none" id="saveSpinner" role="status"></span>
                    Save All
                </button>
                <button type="button" class="btn btn-reset" onclick="resetAll()">Reset All</button>
            </div>

        </div>
    </div>

    <!-- Toast -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="appToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body fw-semibold" id="toastMsg"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const API_BASE = '/api/FaqCategory';
        let blockCounter = 0;

        // ── Build one category block ──
        function createBlockHTML(id) {
            return `
            <div class="category-block" id="block-${id}">
                <div class="block-header">
                    <div class="block-title">
                        <span class="block-number" id="num-${id}">1</span>
                        Category Details
                    </div>
                    <button class="btn-remove-block" onclick="removeBlock(${id})" id="removebtn-${id}" style="display:none">
                        <i class="bi bi-trash3"></i> Remove
                    </button>
                </div>

                <!-- Category Name -->
                <div class="row mb-3 align-items-start">
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label">Category Name <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-9 col-lg-10">
                        <input type="text" id="categoryName-${id}" class="form-control" placeholder="Enter Category Name" oninput="clearErr('categoryName-${id}')" />
                        <div class="invalid-feedback">Category Name is required.</div>
                    </div>
                </div>

                <!-- Category Description -->
                <div class="row mb-3 align-items-start">
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label">Category Description <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-9 col-lg-10">
                        <input type="text" id="categoryDescription-${id}" class="form-control" placeholder="Enter Category Description" oninput="clearErr('categoryDescription-${id}')" />
                        <div class="invalid-feedback">Category Description is required.</div>
                    </div>
                </div>

                <!-- Category Image -->
                <div class="row mb-3 align-items-start">
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label">Category Image</label>
                    </div>
                    <div class="col-md-9 col-lg-10">
                        <div class="custom-file-wrapper" onclick="document.getElementById('imageInput-${id}').click()">
                            <button type="button" class="custom-file-btn">Choose File</button>
                            <span class="custom-file-label" id="fileLabel-${id}">No file chosen</span>
                        </div>
                        <input type="file" id="imageInput-${id}" accept="image/*" style="display:none" onchange="handleFileChange(${id}, this)" />
                        <div id="previewWrapper-${id}" class="mt-2" style="display:none">
                            <img id="imgPreview-${id}" class="img-preview" src="#" alt="Preview" />
                        </div>
                    </div>
                </div>

                <!-- Category Sequence -->
                <div class="row mb-3 align-items-start">
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label">Category Sequence <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-9 col-lg-10">
                        <input type="number" id="categorySequence-${id}" class="form-control" placeholder="Enter Category Sequence" min="1" oninput="clearErr('categorySequence-${id}')" />
                        <div class="invalid-feedback">Category Sequence is required and must be a positive number.</div>
                    </div>
                </div>

                <!-- Is Parent -->
                <div class="row mb-3 align-items-start">
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label">Is Parent</label>
                    </div>
                    <div class="col-md-9 col-lg-10 pt-1">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isParent-${id}" onchange="handleParentToggle(${id}, this)" />
                        </div>
                    </div>
                </div>

                <!-- Parent Sequence -->
                <div class="row mb-3 align-items-start" id="parentSeqRow-${id}">
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label">Parent Sequence <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-9 col-lg-10">
                        <input type="number" id="parentSequence-${id}" class="form-control" placeholder="Enter Parent Sequence" min="1" oninput="clearErr('parentSequence-${id}')" />
                        <div class="invalid-feedback">Parent Sequence is required when Is Parent is disabled.</div>
                    </div>
                </div>
            </div>`;
        }

        // ── Add block ──
        function addCategoryBlock() {
            blockCounter++;
            const container = document.getElementById('categoriesContainer');
            const div = document.createElement('div');
            div.innerHTML = createBlockHTML(blockCounter);
            container.appendChild(div.firstElementChild);

            // Init toggle state
            handleParentToggle(blockCounter, document.getElementById(`isParent-${blockCounter}`));
            updateBlockNumbers();
        }

        // ── Remove block ──
        function removeBlock(id) {
            const el = document.getElementById(`block-${id}`);
            if (el) {
                el.style.transition = 'opacity 0.18s, transform 0.18s';
                el.style.opacity = '0';
                el.style.transform = 'translateY(-8px)';
                setTimeout(() => { el.remove(); updateBlockNumbers(); }, 180);
            }
        }

        // ── Renumber blocks & toggle remove buttons ──
        function updateBlockNumbers() {
            const blocks = document.querySelectorAll('.category-block');
            const count = blocks.length;
            blocks.forEach((block, i) => {
                const id = block.id.replace('block-', '');
                const numEl = document.getElementById(`num-${id}`);
                if (numEl) numEl.textContent = i + 1;
                const removeBtn = document.getElementById(`removebtn-${id}`);
                if (removeBtn) removeBtn.style.display = count > 1 ? '' : 'none';
            });
            const badge = document.getElementById('countBadge');
            badge.textContent = count === 1 ? '1 category' : `${count} categories`;
        }

        // ── Toggle parent sequence row ──
        function handleParentToggle(id, checkbox) {
            const row = document.getElementById(`parentSeqRow-${id}`);
            if (!row) return;
            row.style.display = checkbox.checked ? 'none' : '';
            if (checkbox.checked) {
                const el = document.getElementById(`parentSequence-${id}`);
                if (el) { el.value = ''; clearErr(`parentSequence-${id}`); }
            }
        }

        // ── File change ──
        function handleFileChange(id, input) {
            const file = input.files[0];
            const label = document.getElementById(`fileLabel-${id}`);
            const wrapper = document.getElementById(`previewWrapper-${id}`);
            const preview = document.getElementById(`imgPreview-${id}`);
            if (file) {
                label.textContent = file.name;
                label.style.color = '#1a2540';
                const reader = new FileReader();
                reader.onload = e => { preview.src = e.target.result; wrapper.style.display = 'block'; };
                reader.readAsDataURL(file);
            }
        }

        // ── Validation helpers ──
        function clearErr(id) {
            const el = document.getElementById(id);
            if (el) el.classList.remove('is-invalid');
        }
        function setErr(id) {
            const el = document.getElementById(id);
            if (el) el.classList.add('is-invalid');
        }

        function validateBlock(id) {
            let valid = true;

            const name = document.getElementById(`categoryName-${id}`)?.value.trim();
            name ? clearErr(`categoryName-${id}`) : (setErr(`categoryName-${id}`), valid = false);

            const desc = document.getElementById(`categoryDescription-${id}`)?.value.trim();
            desc ? clearErr(`categoryDescription-${id}`) : (setErr(`categoryDescription-${id}`), valid = false);

            const seq = document.getElementById(`categorySequence-${id}`)?.value.trim();
            (seq && !isNaN(seq) && parseInt(seq) >= 1)
                ? clearErr(`categorySequence-${id}`)
                : (setErr(`categorySequence-${id}`), valid = false);

            if (!document.getElementById(`isParent-${id}`)?.checked) {
                const pSeq = document.getElementById(`parentSequence-${id}`)?.value.trim();
                (pSeq && !isNaN(pSeq) && parseInt(pSeq) >= 1)
                    ? clearErr(`parentSequence-${id}`)
                    : (setErr(`parentSequence-${id}`), valid = false);
            }

            return valid;
        }

        // ── Get payload for one block ──
        async function getBlockPayload(id) {
            let imageBase64 = null;
            const imageFile = document.getElementById(`imageInput-${id}`)?.files[0];
            if (imageFile) {
                imageBase64 = await new Promise(resolve => {
                    const reader = new FileReader();
                    reader.onload = e => resolve(e.target.result);
                    reader.readAsDataURL(imageFile);
                });
            }
            return {
                categoryName: document.getElementById(`categoryName-${id}`).value.trim(),
                categoryDescription: document.getElementById(`categoryDescription-${id}`).value.trim(),
                categoryImage: imageBase64,
                categorySequence: parseInt(document.getElementById(`categorySequence-${id}`).value.trim()),
                isParent: document.getElementById(`isParent-${id}`).checked,
                parentSequence: !document.getElementById(`isParent-${id}`).checked
                    ? parseInt(document.getElementById(`parentSequence-${id}`).value.trim()) || null
                    : null
            };
        }

        // ── Get all block IDs ──
        function getAllBlockIds() {
            return [...document.querySelectorAll('.category-block')].map(b => b.id.replace('block-', ''));
        }

        // ── Save All ──
        async function saveAllCategories() {
            const ids = getAllBlockIds();
            let allValid = true;
            ids.forEach(id => { if (!validateBlock(id)) allValid = false; });
            if (!allValid) { showToast('Please fix the errors before saving.', 'danger'); return; }

            const saveBtn = document.getElementById('saveBtn');
            const spinner = document.getElementById('saveSpinner');
            saveBtn.disabled = true;
            spinner.classList.remove('d-none');

            try {
                const payloads = await Promise.all(ids.map(id => getBlockPayload(id)));

                // Send each as separate POST (or change to bulk endpoint as needed)
                const results = await Promise.all(payloads.map(payload =>
                    fetch(API_BASE, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    }).then(r => r.json().then(data => ({ ok: r.ok, data })))
                ));

                const failed = results.filter(r => !r.ok);
                if (failed.length === 0) {
                    showToast(`${payloads.length} categor${payloads.length > 1 ? 'ies' : 'y'} saved successfully!`, 'success');
                    setTimeout(() => resetAll(), 1600);
                } else {
                    const errMsg = failed[0].data?.errors
                        ? Object.values(failed[0].data.errors).flat().join(' ')
                        : failed[0].data?.title || 'Some categories failed to save.';
                    showToast(errMsg, 'danger');
                }
            } catch (err) {
                showToast('Network error. Please try again.', 'danger');
            } finally {
                saveBtn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        // ── Reset All ──
        function resetAll() {
            document.getElementById('categoriesContainer').innerHTML = '';
            blockCounter = 0;
            addCategoryBlock();
        }

        // ── Toast ──
        function showToast(msg, type = 'success') {
            const toastEl = document.getElementById('appToast');
            document.getElementById('toastMsg').textContent = msg;
            toastEl.className = `toast align-items-center text-white border-0 bg-${type}`;
            new bootstrap.Toast(toastEl, { delay: 3500 }).show();
        }

        // ── Init with one block ──
        addCategoryBlock();
    </script>
</body>
</html>