@{
    ViewData["Title"] = "Neko FAQ Generator";
}
<link href="~/css/AiFaqGen.css" rel="stylesheet" />
<div class="neko-container text-center">
    <span class="cat-icon">🐾</span>
    <h1 class="fw-bold">Neko AI FAQ Generator</h1>
    <p class="text-muted mb-4">Technical wisdom, served with cat puns.</p>

    <div class="card">
        <div class="text-start">
            <label class="form-label fw-bold small text-uppercase">What should Neko research today?</label>
            <input type="text" id="topicInput" class="form-control" placeholder="e.g. How do Databases work?">
        </div>

        <button id="generateBtn" class="btn btn-generate">
            Generate FAQ (Meow!)
        </button>

        <div id="loader" class="loader">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Neko is hunting for data mice...</p>
        </div>

        <div id="faqResult"></div>
    </div>
</div>
<script src="~/js/FaqGen.js"></script>