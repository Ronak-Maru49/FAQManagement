<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FAQ Admin</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body {
            background: #f5f6fa;
            font-family: 'Segoe UI', sans-serif;
        }

        .sidebar {
            width: 240px;
            min-height: 100vh;
            background: #1a1f36;
        }

            .sidebar .nav-link {
                color: #9aa0b9;
                border-radius: 8px;
                padding: 10px;
            }

                .sidebar .nav-link:hover,
                .sidebar .nav-link.active {
                    background: #3b5bdb;
                    color: #fff;
                }

        .main-content {
            flex: 1;
        }

        .topbar {
            background: #fff;
            height: 60px;
            border-bottom: 1px solid #ddd;
            padding: 0 20px;
        }
    </style>
</head>

<body>

    <div class="d-flex">

        <!-- Sidebar -->
        <div class="sidebar p-3 text-white">

            <h4 class="mb-4">🚀 FAQ Admin</h4>

            <!-- Dashboard -->
            <a class="nav-link active" asp-controller="Home" asp-action="Index">
                🏠 Dashboard
            </a>

            <!-- FAQ Menu -->
            <a class="nav-link text-white mt-2" data-bs-toggle="collapse" href="#faqMenu" role="button">
                📋 FAQ
            </a>

            <div class="collapse ps-3" id="faqMenu">
                <a class="nav-link text-white" asp-controller="FAQ" asp-action="List">
                    📄 FAQ List
                </a>
                <a class="nav-link text-white" asp-controller="FAQ" asp-action="Index">
                    ➕ Add FAQ
                </a>
            </div>

            <!-- FAQ Category Menu -->
            <a class="nav-link text-white mt-2" data-bs-toggle="collapse" href="#categoryMenu" role="button">
                🗂️ FAQ Categories
            </a>

            <div class="collapse ps-3" id="categoryMenu">
                <a class="nav-link text-white" asp-controller="FaqCategorys" asp-action="List">
                    📄 Category List
                </a>
                <a class="nav-link text-white" asp-controller="FaqCategorys" asp-action="Index">
                    ➕ Add Category
                </a>
            </div>
 
                <a class="nav-link text-white mt-2 d-flex align-items-center gap-2"
                   asp-controller="AiFaqGen"
                   asp-action="Index">
                <span> 🤖 </span> AI Generate FAQ
                </a>
            
        </div>
        <!-- Main Content -->
        <div class="main-content d-flex flex-column w-100">

            <!-- Topbar -->
            <div class="topbar d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@ViewData["Title"]</h5>

                <div>
                    <span class="me-3">🔔</span>
                    <span>Admin</span>
                </div>
            </div>

            <!-- Page Content -->
            <div class="container mt-4">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="text-center mt-auto p-3 text-muted">
                © 2026 - FAQManagement
            </footer>

        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
