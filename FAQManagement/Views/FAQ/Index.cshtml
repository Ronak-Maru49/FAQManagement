@{
    ViewData["Title"] = "Add FAQ Sections";
}

<a href="javascript:void(0);"
   onclick="history.back();"
   class="btn btn-primary float-end"
   style="background-color: #0d6efd; padding: 8px 20px; border-radius: 8px; font-weight: 500; display: inline-flex; align-items: center; gap: 8px;">
    ← Back
</a>

<div class="container mt-4">
    <h2>Add FAQ Sections</h2>
    <p class="text-muted">Select the main category in the first section. All items will belong to this category.</p>

    <div id="faqSectionsContainer">
        <div class="faq-section" style="background: #f9f9f9; padding: 20px; border-radius: 8px; border: 1px solid #ddd; margin-bottom: 20px; position: relative;">
            <h5>FAQ Item #1 (Primary)</h5>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Category *</label>
                    <select id="mainCategory" class="form-control" required>
                        <option value="">Loading Categories...</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Sub Category</label>
                    <select class="subcategory-input form-control">
                        <option value="">-- Select Sub Category --</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">FAQ Title *</label>
                <input type="text" class="question-input form-control" placeholder="Enter title/question" required />
            </div>

            <div class="mb-3">
                <label class="fw-bold">FAQ Description *</label>
                <textarea class="answer-input form-control" rows="3" placeholder="Enter description/answer" required></textarea>
            </div>
        </div>
    </div>

    <div class="mb-5">
        <button type="button" id="addMoreBtn" class="btn btn-info text-white bg-primary">+ Add Another Section</button>
        <button type="button" id="submitAllBtn" class="btn btn-success" style="margin-left: 10px;">Submit All FAQs</button>
    </div>

    <div id="result" style="margin-top:20px; font-weight: bold;"></div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            const CAT_API = '/api/FaqCategory';
            const SUB_CAT_API = '/api/FaqSubCategory';

            // URL se categoryId nikalo — ?categoryId=5
            const urlParams = new URLSearchParams(window.location.search);
            const TARGET_PARENT_ID = parseInt(urlParams.get('categoryId')) || 0;

            window.allSubCategories = [];

            async function initialize() {
                try {
                    // Categories fetch karo
                    const catRes = await fetch(CAT_API);
                    const categories = await catRes.json();

                    let catHtml = '<option value="">Select Category</option>';
                    categories.forEach(c => {
                        let isSelected = (c.id === TARGET_PARENT_ID) ? 'selected' : '';
                        catHtml += `<option value="${c.id}" ${isSelected}>${c.categoryName}</option>`;
                    });
                    $('#mainCategory').html(catHtml);

                    // SubCategories fetch karo
                    const subRes = await fetch(SUB_CAT_API);
                    window.allSubCategories = await subRes.json();

                    // Agar category pre-selected hai toh subcategory dropdown bhi fill karo
                    if (TARGET_PARENT_ID > 0) {
                        updateSubCategoryDropdowns($('.subcategory-input'), 0);
                    }

                } catch (e) {
                    console.error("Error loading data:", e);
                    $('#result').html('<span class="text-danger">Error loading categories.</span>');
                }
            }

            function updateSubCategoryDropdowns(element, selectedId) {
                const currentParent = $('#mainCategory').val();
                let subHtml = '<option value="">-- Select Sub Category --</option>';

                if (window.allSubCategories && currentParent) {
                    const filtered = window.allSubCategories.filter(s => s.categoryId == currentParent);
                    filtered.forEach(s => {
                        let isSelected = (s.id == selectedId) ? 'selected' : '';
                        subHtml += `<option value="${s.id}" ${isSelected}>${s.subCategoryName}</option>`;
                    });
                }
                element.html(subHtml);
            }

            // Main category change hone par saare sub dropdowns update karo
            $(document).on('change', '#mainCategory', function () {
                $('.subcategory-input').each(function () {
                    updateSubCategoryDropdowns($(this), 0);
                });
            });

            // Add More Section
            $('#addMoreBtn').click(function () {
                const sectionCount = $('.faq-section').length + 1;
                const newSection = $(`
                    <div class="faq-section" style="background: #f9f9f9; padding: 20px; border-radius: 8px; border: 1px solid #ddd; margin-bottom: 20px; position: relative;">
                        <button type="button" class="remove-section" style="position: absolute; top: 10px; right: 10px; background: red; color: white; border: none; border-radius: 50%; width: 25px; height: 25px; cursor: pointer;">&times;</button>
                        <h5>FAQ Item #${sectionCount}</h5>

                        <div class="mb-3">
                            <label class="fw-bold">Sub Category</label>
                            <select class="subcategory-input form-control"></select>
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold">FAQ Title *</label>
                            <input type="text" class="question-input form-control" placeholder="Enter title" required />
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold">FAQ Description *</label>
                            <textarea class="answer-input form-control" rows="3" placeholder="Enter description" required></textarea>
                        </div>
                    </div>`);

                $('#faqSectionsContainer').append(newSection);
                updateSubCategoryDropdowns(newSection.find('.subcategory-input'), 0);
            });

            // Remove Section
            $(document).on('click', '.remove-section', function () {
                $(this).closest('.faq-section').remove();
            });

            // Submit
            $('#submitAllBtn').click(async function () {
                const selectedCategory = $('#mainCategory').val();
                if (!selectedCategory) {
                    alert("Please select a Category first.");
                    return;
                }

                const sections = $('.faq-section');
                let successCount = 0;
                $('#result').html('<span class="text-primary">Saving FAQs...</span>');

                for (let section of sections) {
                    const faqData = {
                        question: $(section).find('.question-input').val().trim(),
                        answer: $(section).find('.answer-input').val().trim(),
                        categoryId: parseInt(selectedCategory),
                        subCategoryId: parseInt($(section).find('.subcategory-input').val()) || null
                    };

                    if (!faqData.question || !faqData.answer) continue;

                    try {
                        await $.ajax({
                            url: '/api/Faq',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(faqData)
                        });
                        successCount++;
                    } catch (err) {
                        console.error("Failed to save an item", err);
                    }
                }

                if (successCount > 0) {
                    $('#result').html(`<span class="text-success">Successfully added ${successCount} FAQs!</span>`);
                    $('.question-input, .answer-input').val('');
                } else {
                    $('#result').html('<span class="text-danger">No FAQs were saved. Please check the fields.</span>');
                }
            });

            initialize();
        });
    </script>
}