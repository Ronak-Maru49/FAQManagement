@{
    ViewData["Title"] = "Add FAQ Sections";
}

<div class="container mt-4">
    <h2>Add FAQ Sections</h2>
    <p class="text-muted">Select the main category in the first section. You can define specific sub-categories for each item.</p>

    <div id="faqSectionsContainer">
        <div class="faq-section" style="background: #f9f9f9; padding: 20px; border-radius: 8px; border: 1px solid #ddd; margin-bottom: 20px; position: relative;">
            <h5>FAQ Item #1 (Primary)</h5>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Category *</label>
                    <select id="mainCategory" class="form-control" required>
                        <option value="">Select Category</option>
                        <option value="AI MVP development">AI MVP development</option>
                        <option value="AI & Machine Learning Development">AI & Machine Learning Development</option>
                        <option value="AI Integration">AI Integration</option>
                        <option value="AI Chatbot Development">AI Chatbot Development</option>
                        <option value="AI SaaS Development">AI SaaS Development</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Sub Category</label>
                    <select class="subcategory-input form-control">
                        <option value="">-- Select Sub Category --</option>
                        <option value="General">General</option>
                        <option value="Technical">Technical</option>
                        <option value="Pricing">Pricing</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">FAQ Title *</label>
                <input type="text" class="question-input form-control" placeholder="Enter title/question" required />
            </div>

            <div class="mb-3">
                <label class="fw-bold">FAQ Description *</label>
                <textarea class="answer-input form-control" rows="3" placeholder="Enter description/answer" required></textarea>
            </div>
        </div>
    </div>

    <div class="mb-5">
        <button type="button" id="addMoreBtn" style="background: #007bff; color: white; padding: 10px 20px; border: none; cursor: pointer; border-radius: 4px;">+ Add Another Section</button>
        <button type="button" id="submitAllBtn" style="background: green; color: white; padding: 10px 20px; border: none; cursor: pointer; border-radius: 4px; margin-left: 10px;">Submit All FAQs</button>
    </div>

    <div id="result" style="margin-top:20px; font-weight: bold;"></div>
</div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/Faq.js"></script>