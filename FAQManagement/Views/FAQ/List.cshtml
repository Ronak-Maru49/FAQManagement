@{
    ViewData["Title"] = "FAQ Management";
}

<style>
    .faq-table-wrap {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #dee2e6;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .faq-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .faq-table thead tr {
            background: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
        }

        .faq-table thead th {
            padding: 14px 16px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #495057;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .faq-table tbody tr {
            border-bottom: 1px solid #f0f0f0;
            transition: background 0.15s;
        }

            .faq-table tbody tr:last-child {
                border-bottom: none;
            }

            .faq-table tbody tr:hover {
                background: #f8f9ff;
            }

        .faq-table td {
            padding: 14px 16px;
            vertical-align: top;
            font-size: 0.9rem;
            color: #333;
        }

    .question-cell {
        font-weight: 600;
        color: #1a2540;
    }

    .answer-cell {
        color: #6c757d;
        max-width: 400px;
    }

    .badge-num {
        background: #e8f0fe;
        color: #1a73e8;
        border-radius: 50%;
        width: 26px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.78rem;
        font-weight: 600;
        margin-right: 6px;
        flex-shrink: 0;
    }

    /* Edit Form */
    .edit-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #dee2e6;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        padding: 24px;
        margin-bottom: 24px;
        border-left: 4px solid #0d6efd;
    }

        .edit-card h5 {
            font-weight: 600;
            color: #1a2540;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .btn-update {
        background: #0d6efd;
        color: #fff;
        border: none;
        padding: 8px 24px;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
    }

        .btn-update:hover {
            background: #0b5ed7;
        }

    .btn-cancel-edit {
        background: #f8f9fa;
        color: #495057;
        border: 1px solid #dee2e6;
        padding: 8px 20px;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        margin-left: 8px;
    }

        .btn-cancel-edit:hover {
            background: #e9ecef;
        }

    /* Action buttons */
    .btn-edit-faq {
        background: #0d6efd;
        color: white;
        border: none;
        padding: 5px 12px;
        border-radius: 5px;
        font-size: 0.8rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .btn-delete-faq {
        background: #dc3545;
        color: white;
        border: none;
        padding: 5px 12px;
        border-radius: 5px;
        font-size: 0.8rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-left: 6px;
    }

    .btn-edit-faq:hover {
        background: #0b5ed7;
    }

    .btn-delete-faq:hover {
        background: #bb2d3b;
    }

    /* Top bar */
    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .page-heading {
        font-size: 1.3rem;
        font-weight: 700;
        color: #1a2540;
        margin: 0;
    }

    .count-pill {
        background: #e8f0fe;
        color: #1a73e8;
        border-radius: 20px;
        padding: 3px 12px;
        font-size: 0.8rem;
        font-weight: 600;
        margin-left: 10px;
    }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #adb5bd;
    }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 12px;
            display: block;
        }

    /* Result toast-like */
    #result {
        margin-bottom: 16px;
    }

    /* Search bar */
    .search-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
    }
</style>

<!-- Top Bar -->
<div class="top-bar">
    <div class="d-flex align-items-center">
        <h5 class="page-heading">FAQ Management</h5>
        <span class="count-pill" id="faqCount">0 FAQs</span>
    </div>
    <a href="javascript:void(0);"
       onclick="history.back();"
       class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<!-- Edit Form -->
<div id="editSection" style="display:none;">
    <div class="edit-card">
        <h5><i class="bi bi-pencil-square text-primary"></i> Edit FAQ</h5>
        <form id="faqForm">
            <input type="hidden" id="faqId" value="0" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Question <span class="text-danger">*</span></label>
                <input type="text" id="Question" class="form-control" placeholder="Enter question" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Answer <span class="text-danger">*</span></label>
                <textarea id="Answer" class="form-control" rows="3" placeholder="Enter answer" required></textarea>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button type="submit" class="btn-update">
                    <span id="updateSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                    Update FAQ
                </button>
                <button type="button" class="btn-cancel-edit" onclick="cancelEdit()">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- Result Message -->
<div id="result"></div>

<!-- Search -->
<div class="search-bar">
    <input type="text"
           id="searchInput"
           class="form-control form-control-sm"
           style="max-width:280px"
           placeholder="🔍 Search FAQs..."
           oninput="searchFaqs()" />
</div>

<!-- FAQ Table -->
<div class="faq-table-wrap">
    <table class="faq-table">
        <thead>
            <tr>
                <th style="width:40px;">#</th>
                <th>Question</th>
                <th>Answer</th>
                <th style="width:150px; text-align:center;">Actions</th>
            </tr>
        </thead>
        <tbody id="faqTableBody">
            <tr>
                <td colspan="4">
                    <div class="empty-state">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-muted">Loading FAQs...</p>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-body text-center p-4">
                <i class="bi bi-exclamation-circle text-danger" style="font-size:2.5rem"></i>
                <h6 class="mt-3">Delete this FAQ?</h6>
                <p class="text-muted" style="font-size:0.82rem">This cannot be undone.</p>
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-light flex-fill" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-danger flex-fill" onclick="confirmDelete()">
                        <span id="deleteSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="appToast" class="toast align-items-center text-white border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="toastMsg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        let allFaqs = [];
        let deleteTargetId = null;
        let deleteModalInstance = null;

        $(document).ready(function () {
            loadFaqs();

            $('#faqForm').submit(function (e) {
                e.preventDefault();
                updateFaq();
            });
        });

        // ── Load FAQs ──
        function loadFaqs() {
            $.ajax({
                url: '/api/Faq',
                type: 'GET',
                success: function (data) {
                    allFaqs = data;
                    renderTable(data);
                    document.getElementById('faqCount').textContent =
                        data.length === 1 ? '1 FAQ' : `${data.length} FAQs`;
                },
                error: function () {
                    $('#faqTableBody').html(`
                        <tr><td colspan="4">
                            <div class="empty-state">
                                <i class="bi bi-exclamation-circle text-danger"></i>
                                <p>Failed to load FAQs.</p>
                            </div>
                        </td></tr>`);
                }
            });
        }

        function renderTable(data) {
            if (!data || data.length === 0) {
                $('#faqTableBody').html(`
                    <tr><td colspan="4">
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <p>No FAQs found.</p>
                        </div>
                    </td></tr>`);
                return;
            }

            let rows = '';
            data.forEach((item, index) => {
                rows += `
                    <tr id="faq-row-${item.id}">
                        <td><span class="badge-num">${index + 1}</span></td>
                        <td class="question-cell">${item.question || ''}</td>
                        <td class="answer-cell">${item.answer || ''}</td>
                        <td style="text-align:center; white-space:nowrap;">
                            <button class="btn-edit-faq" onclick="editFaq(${item.id})">
                                <i class="bi bi-pencil-fill"></i> Edit
                            </button>
                            <button class="btn-delete-faq" onclick="openDeleteModal(${item.id})">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </td>
                    </tr>`;
            });
            $('#faqTableBody').html(rows);
        }

        // ── Search ──
        function searchFaqs() {
            const query = document.getElementById('searchInput').value.trim().toLowerCase();
            if (!query) {
                renderTable(allFaqs);
                return;
            }
            const filtered = allFaqs.filter(f =>
                (f.question || '').toLowerCase().includes(query) ||
                (f.answer || '').toLowerCase().includes(query)
            );
            renderTable(filtered);
        }

        // ── Edit ──
        function editFaq(id) {
            $.ajax({
                url: '/api/Faq/' + id,
                type: 'GET',
                success: function (faq) {
                    $('#faqId').val(faq.id);
                    $('#Question').val(faq.question);
                    $('#Answer').val(faq.answer);
                    $('#editSection').slideDown();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
        }

        async function updateFaq() {
            const id = $('#faqId').val();
            const faqData = {
                id: parseInt(id),
                question: $('#Question').val().trim(),
                answer: $('#Answer').val().trim()
            };

            document.getElementById('updateSpinner').classList.remove('d-none');

            try {
                const res = await fetch('/api/Faq/' + id, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(faqData)
                });

                if (res.ok) {
                    showToast('FAQ updated successfully!', 'success');
                    cancelEdit();
                    loadFaqs();
                } else {
                    showToast('Update failed. Try again.', 'danger');
                }
            } catch (e) {
                showToast('Network error.', 'danger');
            } finally {
                document.getElementById('updateSpinner').classList.add('d-none');
            }
        }

        function cancelEdit() {
            $('#editSection').slideUp();
            $('#faqForm')[0].reset();
            $('#faqId').val("0");
        }

        // ── Delete ──
        function openDeleteModal(id) {
            deleteTargetId = id;
            deleteModalInstance = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModalInstance.show();
        }

        async function confirmDelete() {
            if (!deleteTargetId) return;
            document.getElementById('deleteSpinner').classList.remove('d-none');

            try {
                const res = await fetch('/api/Faq/' + deleteTargetId, { method: 'DELETE' });
                if (res.ok) {
                    deleteModalInstance.hide();
                    const row = document.getElementById(`faq-row-${deleteTargetId}`);
                    if (row) {
                        row.style.transition = 'opacity 0.2s';
                        row.style.opacity = '0';
                        setTimeout(() => {
                            row.remove();
                            allFaqs = allFaqs.filter(f => f.id !== deleteTargetId);
                            document.getElementById('faqCount').textContent =
                                allFaqs.length === 1 ? '1 FAQ' : `${allFaqs.length} FAQs`;
                        }, 200);
                    }
                    showToast('FAQ deleted!', 'success');
                    if ($('#faqId').val() == deleteTargetId) cancelEdit();
                } else {
                    showToast('Delete failed.', 'danger');
                }
            } catch (e) {
                showToast('Network error.', 'danger');
            } finally {
                document.getElementById('deleteSpinner').classList.add('d-none');
                deleteTargetId = null;
            }
        }

        // ── Toast ──
        function showToast(msg, type = 'success') {
            const toastEl = document.getElementById('appToast');
            document.getElementById('toastMsg').textContent = msg;
            toastEl.className = `toast align-items-center text-white border-0 bg-${type}`;
            new bootstrap.Toast(toastEl, { delay: 3000 }).show();
        }
    </script>
}